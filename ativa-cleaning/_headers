# Cabeçalhos do Cloudflare (este arquivo não aparece no site).

# Enquanto o site estiver só no endereço .workers.dev (prévia), o Google não indexa.
# Quando o domínio ativacleaning.com.au for ligado ao site, ele fica indexável normalmente.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fotos: uma semana (se trocar um arquivo, use um nome novo para atualizar na hora)
/assets/img/*
  Cache-Control: public, max-age=604800
