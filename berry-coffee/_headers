# Cabeçalhos do Cloudflare Pages (este arquivo não aparece no site).

# Enquanto o site estiver só no endereço .workers.dev (ou .pages.dev), o Google não indexa a prévia.
# Quando o domínio theberrycoffee.ie for ligado ao site, ele fica indexável normalmente.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# As fontes nunca mudam de conteúdo: o navegador pode guardar por um ano
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
