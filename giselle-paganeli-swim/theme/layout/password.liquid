<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    {{ 'cormorant-garamond.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <title>{{ shop.name }}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = { routes: { root: {{ routes.root_url | json }} }, strings: {} };
    </script>
    {{ content_for_header }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="template-password" data-animate="{{ settings.animations_reveal }}">
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
