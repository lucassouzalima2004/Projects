<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {{ 'lato-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'lato-300.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'theme-styles' %}

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        motion: {
          smoothScroll: {{ settings.smooth_scroll | json }},
          parallax: {{ settings.parallax | json }},
          splitHeadings: {{ settings.split_headings | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          selectSize: {{ 'products.product.select_size' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          cartError: {{ 'sections.cart.error' | t | json }},
          searchNoResults: {{ 'templates.search.no_results_short' | t | json }},
          drag: {{ 'sections.gallery.drag' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}

    {%- if settings.smooth_scroll -%}
      <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    {%- endif %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body
    class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}"
    data-animate="{{ settings.animations_reveal }}"
    data-transitions="{{ settings.page_transitions }}"
  >
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% render 'brand-sprite' %}

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}

    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  </body>
</html>
