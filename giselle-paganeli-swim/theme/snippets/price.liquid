{%- comment -%}
  Accepts: product, variant (optional), class
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if variant == blank and product.price_varies
    assign price = product.price_min
    assign compare = blank
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %} {{ class }}" data-price>
  {%- if variant == blank and product.price_varies -%}
    <span class="price__from">{{ 'products.product.price.from' | t }}</span>
  {%- endif -%}
  <span class="price__current" data-price-current>{{ price | money }}</span>
  <s class="price__compare" data-price-compare{% unless on_sale %} hidden{% endunless %}>
    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
    <span data-price-compare-value>{% if on_sale %}{{ compare | money }}{% endif %}</span>
  </s>
</div>
