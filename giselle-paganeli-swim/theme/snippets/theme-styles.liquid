{%- liquid
  assign heading_scale = settings.heading_scale | divided_by: 100.0
  assign body_scale = settings.body_scale | divided_by: 100.0
  case settings.card_ratio
    when 'tall'
      assign card_ratio = '2 / 3'
    when 'square'
      assign card_ratio = '1 / 1'
    else
      assign card_ratio = '4 / 5'
  endcase
-%}
<style>
  @font-face {
    font-family: 'Lato';
    src: url('{{ 'lato-300.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lato';
    src: url('{{ 'lato-300-italic.woff2' | asset_url }}') format('woff2');
    font-weight: 300;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lato';
    src: url('{{ 'lato-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Lato';
    src: url('{{ 'lato-700.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --c-paper: {{ settings.color_background }};
    --c-surface: {{ settings.color_surface }};
    --c-grey: {{ settings.color_sand }};
    --c-ink: {{ settings.color_text }};
    --c-black: {{ settings.color_nero }};
    --c-accent: {{ settings.color_accent }};
    --c-detail: {{ settings.color_gold }};
    --c-charcoal: {{ settings.color_garden }};

    --heading-scale: {{ heading_scale }};
    --body-scale: {{ body_scale }};
    --page-width: {{ settings.page_width }}px;
    --logo-width: {{ settings.logo_width }}px;
    --card-ratio: {{ card_ratio }};
  }
  {%- if settings.page_transitions %}
    @view-transition { navigation: auto; }
  {%- endif %}
</style>
