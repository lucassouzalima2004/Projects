{%- liquid
  assign heading_scale = settings.heading_scale | divided_by: 100.0
  assign body_scale = settings.body_scale | divided_by: 100.0
  case settings.card_ratio
    when 'tall'
      assign card_ratio = '2 / 3'
    when 'square'
      assign card_ratio = '1 / 1'
    else
      assign card_ratio = '4 / 5'
  endcase
-%}
<style>
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'cormorant-garamond.woff2' | asset_url }}') format('woff2');
    font-weight: 300 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    src: url('{{ 'cormorant-garamond-italic.woff2' | asset_url }}') format('woff2');
    font-weight: 300 700;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Jost';
    src: url('{{ 'jost.woff2' | asset_url }}') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --c-pearl: {{ settings.color_background }};
    --c-ivory: {{ settings.color_surface }};
    --c-sand: {{ settings.color_sand }};
    --c-cafe: {{ settings.color_text }};
    --c-nero: {{ settings.color_nero }};
    --c-terracotta: {{ settings.color_accent }};
    --c-gold: {{ settings.color_gold }};
    --c-garden: {{ settings.color_garden }};
    --c-water: {{ settings.color_water }};

    --heading-scale: {{ heading_scale }};
    --body-scale: {{ body_scale }};
    --page-width: {{ settings.page_width }}px;
    --logo-width: {{ settings.logo_width }}px;
    --card-ratio: {{ card_ratio }};
  }
  {%- if settings.page_transitions %}
    @view-transition { navigation: auto; }
  {%- endif %}
</style>
