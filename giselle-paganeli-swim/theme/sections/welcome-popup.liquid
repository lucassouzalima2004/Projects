{%- comment -%}
  Welcome window with a discount on the first order. It opens once per visitor a few seconds after the first
  page; signing up creates a customer subscribed to email marketing and shows the code right away.
  Create the same code in Shopify (Discounts) and limit it to one use per customer.
{%- endcomment -%}
{%- liquid
  assign show = section.settings.enabled
  if template.name == 'cart' or template.name == 'password' or template.directory == 'customers'
    assign show = false
  endif
-%}
{%- if show -%}
  {%- form 'customer', id: 'WelcomePopupForm', class: 'popup__form' -%}
    {%- liquid
      assign signed_up = form.posted_successfully?
    -%}
    <welcome-popup
      class="popup"
      data-delay="{{ section.settings.delay }}"
      data-days="{{ section.settings.days }}"
      data-section="{{ section.id }}"
      {% if signed_up %}
        data-success
      {% endif %}
    >
      <dialog class="popup__dialog" aria-labelledby="PopupTitle-{{ section.id }}" data-lenis-prevent autofocus>
        <button type="button" class="popup__close" data-popup-close aria-label="{{ 'accessibility.close' | t | escape }}">
          {%- render 'icon', name: 'close' -%}
        </button>
        <div class="popup__body{% if section.settings.image == blank %} popup__body--text{% endif %}">
          <div class="popup__content">
            <div class="popup__step" data-popup-step="form"{% if signed_up %} hidden{% endif %}>
              {%- if section.settings.overline != blank -%}
                <p class="overline">{{ section.settings.overline }}</p>
              {%- endif -%}
              <h2 class="popup__title" id="PopupTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
              {%- if section.settings.text != blank -%}
                <div class="popup__text rte">{{ section.settings.text }}</div>
              {%- endif -%}
              <input type="hidden" name="contact[tags]" value="newsletter,welcome">
              <label class="visually-hidden" for="PopupEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="PopupEmail-{{ section.id }}"
                class="popup__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ 'newsletter.placeholder' | t | escape }}"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="PopupError-{{ section.id }}"
                {% endif %}
              >
              <label class="consent">
                <input type="checkbox" required>
                <span class="consent__text">{{ 'newsletter.consent' | t }}</span>
              </label>
              {%- if form.errors -%}
                <p id="PopupError-{{ section.id }}" class="form-message form-message--error">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              <button type="submit" class="button button--full">{{ section.settings.button_label }}</button>
              <button type="button" class="link link--small popup__later" data-popup-close>{{ 'sections.popup.later' | t }}</button>
            </div>

            <div class="popup__step popup__step--success" data-popup-step="success"{% unless signed_up %} hidden{% endunless %}>
              <p class="overline">{{ section.settings.overline }}</p>
              <p class="popup__title">{{ section.settings.success_heading }}</p>
              {%- if section.settings.success_text != blank -%}
                <div class="popup__text rte">{{ section.settings.success_text }}</div>
              {%- endif -%}
              {%- if section.settings.code != blank -%}
                <p class="popup__code" data-popup-code>{{ section.settings.code }}</p>
                <button
                  type="button"
                  class="button button--ghost button--full"
                  data-popup-copy
                  data-copied="{{ 'sections.popup.copied' | t | escape }}"
                >
                  {{- 'sections.popup.copy' | t -}}
                </button>
              {%- endif -%}
              <a href="{{ routes.all_products_collection_url }}" class="button button--full" data-popup-close>
                {{- 'sections.popup.shop' | t -}}
              </a>
            </div>
          </div>
          {%- if section.settings.image != blank -%}
            <div class="popup__media">
              {%- render 'media', image: section.settings.image, sizes: '(min-width: 750px) 26rem, 100vw', widths: '480, 720, 960', alt: '' -%}
            </div>
          {%- endif -%}
        </div>
      </dialog>
    </welcome-popup>
  {%- endform -%}
{%- endif -%}

{% schema %}
{
  "name": "Welcome popup",
  "class": "section-popup",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the welcome popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Open after",
      "default": 5
    },
    {
      "type": "range",
      "id": "days",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "label": "Show again after",
      "info": "Days before the popup returns to a visitor who closed it.",
      "default": 30
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "Welcome"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10% off your first order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Join the garden and be the first to see new pieces and private previews.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "After signing up"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Heading",
      "default": "Welcome to the garden"
    },
    {
      "type": "richtext",
      "id": "success_text",
      "label": "Text",
      "default": "<p>Your code for the first order:</p>"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount code",
      "info": "Create the same code in Discounts, limited to one use per customer.",
      "default": "WELCOME10"
    }
  ],
  "presets": [
    {
      "name": "Welcome popup"
    }
  ]
}
{% endschema %}
