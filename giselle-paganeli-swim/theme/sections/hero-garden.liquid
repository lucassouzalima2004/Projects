{%- comment -%}
  "Enter the garden": the campaign image sits inside an arch and opens to full screen as the visitor scrolls.
{%- endcomment -%}
<garden-hero
  class="hero scheme-{{ section.settings.color_scheme }}{% if section.settings.reveal %} hero--reveal{% endif %}"
  style="--hero-focal: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;"
>
  <div class="hero__stage">
    <div class="hero__intro">
      {%- if section.settings.overline != blank -%}
        <p class="overline hero__overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hero__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="hero__window">
      <div class="hero__media">
        {%- if section.settings.image_mobile != blank -%}
          <div class="hero__img hero__img--mobile">
            {%- render 'media', image: section.settings.image_mobile, sizes: '100vw', priority: true -%}
          </div>
        {%- endif -%}
        <div class="hero__img{% if section.settings.image_mobile != blank %} hero__img--desktop{% endif %}">
          {%- render 'media',
            image: section.settings.image,
            artwork: section.settings.artwork,
            sizes: '100vw',
            priority: true,
            alt: section.settings.heading
          -%}
        </div>
      </div>
      <div class="hero__veil"></div>
      <div class="hero__inside">
        {%- if section.settings.claim != blank -%}
          <p class="hero__claim">{{ section.settings.claim }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--light">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      <span>{{ 'sections.hero.scroll' | t }}</span>
    </div>
  </div>
</garden-hero>

{% schema %}
{
  "name": "Enter the garden",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image",
      "info": "Landscape, 2400 px wide or more."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Portrait 4:5 or 9:16."
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Artwork until an image is chosen",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "garden", "label": "The Garden" },
        { "value": "lake", "label": "Lake and mountain" },
        { "value": "canopy", "label": "Vines" },
        { "value": "palm", "label": "Palms" },
        { "value": "valley", "label": "Valley" },
        { "value": "flowers", "label": "Flowers" },
        { "value": "stream", "label": "Stream" },
        { "value": "bloom", "label": "Bloom" }
      ],
      "default": "garden"
    },
    {
      "type": "range",
      "id": "focal_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Focal point, horizontal",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Focal point, vertical",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Open the arch on scroll",
      "info": "Visitors who prefer reduced motion see the full image.",
      "default": true
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "The Garden of Eden 2027"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enter the Garden"
    },
    {
      "type": "text",
      "id": "claim",
      "label": "Text on the image",
      "default": "embrace your oasis"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors around the arch",
      "options": [
        { "value": "pearl", "label": "Pearl" },
        { "value": "ivory", "label": "Off-white" },
        { "value": "sand", "label": "Sand" },
        { "value": "cafe", "label": "Café" },
        { "value": "garden", "label": "Garden green" },
        { "value": "nero", "label": "Black" }
      ],
      "default": "pearl"
    }
  ],
  "presets": [
    {
      "name": "Enter the garden"
    }
  ]
}
{% endschema %}
