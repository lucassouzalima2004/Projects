<section class="banner banner--{{ section.settings.height }} banner--{{ section.settings.position }}" style="--veil: {{ section.settings.veil | divided_by: 100.0 }};">
  <div class="banner__media">
    {%- render 'media',
      image: section.settings.image,
      artwork: section.settings.artwork,
      sizes: '100vw',
      priority: section.settings.priority,
      alt: section.settings.heading
    -%}
  </div>
  <div class="banner__content page-width" data-reveal>
    {%- if section.settings.overline != blank -%}
      <p class="overline">{{ section.settings.overline }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- if section.settings.heading_as_title -%}
        <h1 class="banner__title">{{ section.settings.heading }}</h1>
      {%- else -%}
        <h2 class="banner__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="banner__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.caption != blank -%}
    <p class="banner__caption page-width">{{ section.settings.caption }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Image banner",
  "tag": "div",
  "class": "section-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Artwork until an image is chosen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "valley"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Text position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "veil",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "First section of the page",
      "info": "Loads the image right away.",
      "default": false
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Garden of Eden"
    },
    {
      "type": "checkbox",
      "id": "heading_as_title",
      "label": "Use heading as page title (H1)",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image credit"
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}
