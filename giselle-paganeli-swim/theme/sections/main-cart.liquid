<section class="cart-page scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="cart-page__head" data-reveal>
      {%- render 'icon', name: 'clover' -%}
      <h1 class="page-hero__title">{{ 'sections.cart.title' | t }}</h1>
    </header>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page__grid" novalidate>
        <cart-items class="cart-page__lines" data-section="{{ section.id }}">
          <ul class="cart-lines cart-lines--page" role="list">
            {%- for item in cart.items -%}
              {%- render 'cart-line', item: item, index: forloop.index, page: true -%}
            {%- endfor -%}
          </ul>
        </cart-items>

        <aside class="cart-page__summary">
          {%- if settings.cart_note -%}
            <label class="field">
              <span>{{ 'sections.cart.note' | t }}</span>
              <textarea name="note" rows="3" data-cart-note>{{ cart.note }}</textarea>
            </label>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-total cart-total--discount">
              <span>{{ discount.title }}</span>
              <span>−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-total">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span class="cart-total__value">{{ cart.total_price | money_with_currency }}</span>
          </div>
          {%- if settings.cart_footer_text != blank -%}
            <div class="cart-footer-text rte">{{ settings.cart_footer_text }}</div>
          {%- endif -%}
          <button type="submit" name="checkout" class="button button--full">{{ 'sections.cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div class="cart-page__express">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
          <a href="{{ routes.all_products_collection_url }}" class="link link--small">{{ 'sections.cart.continue' | t }}</a>
        </aside>
      </form>
    {%- else -%}
      <div class="cart-empty cart-empty--page">
        <p class="cart-empty__title">{{ 'sections.cart.empty' | t }}</p>
        <p class="cart-empty__text">{{ 'sections.cart.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "div",
  "class": "section-cart",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        }
      ],
      "default": "pearl"
    }
  ]
}
{% endschema %}
