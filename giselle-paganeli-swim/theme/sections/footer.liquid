<footer class="footer scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_newsletter -%}
    <div class="footer__newsletter page-width" data-reveal>
      {%- render 'icon', name: 'clover' -%}
      {%- if section.settings.newsletter_heading != blank -%}
        <h2 class="footer__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.newsletter_text != blank -%}
        <div class="footer__newsletter-text rte">{{ section.settings.newsletter_text }}</div>
      {%- endif -%}
      {% render 'newsletter-form', id: 'FooterNewsletter', tags: 'newsletter,footer' %}
    </div>
  {%- endif -%}

  <div class="footer__grid page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__col footer__col--brand" {{ block.shopify_attributes }}>
            <a href="{{ routes.root_url }}" class="logo logo--footer">{%- render 'wordmark', tone: 'light' -%}</a>
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {% render 'social-links' %}
          </div>
        {%- when 'menu' -%}
          {%- assign footer_menu = block.settings.menu -%}
          {%- if footer_menu.links.size > 0 -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | default: footer_menu.title | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | default: footer_menu.title }}</h2>
              <ul class="footer__links" role="list">
                {%- for link in footer_menu.links -%}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- when 'contact' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul class="footer__links" role="list">
              {%- if settings.contact_email != blank -%}
                <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
              {%- endif -%}
              {%- if settings.whatsapp_number != blank -%}
                <li><a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">WhatsApp</a></li>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <li class="footer__text rte">{{ block.settings.text }}</li>
              {%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom page-width">
    {%- if section.settings.show_localization -%}
      {% render 'localization-form', id: 'Footer', class: 'localization localization--footer' %}
    {%- endif -%}
    <p class="footer__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- for link in section.settings.legal_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </p>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if section.settings.show_big_wordmark -%}
    <div class="footer__giant" aria-hidden="true">
      <span>{{ settings.wordmark_name | default: shop.name }}</span>
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "pearl", "label": "Pearl" },
        { "value": "ivory", "label": "Off-white" },
        { "value": "sand", "label": "Sand" },
        { "value": "cafe", "label": "Café" },
        { "value": "garden", "label": "Garden green" },
        { "value": "nero", "label": "Black" }
      ],
      "default": "cafe"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter sign-up",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the Garden"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Text",
      "default": "<p>Private previews, travel notes and the first look at every new chapter.</p>"
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country and language selectors",
      "default": true
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_big_wordmark",
      "label": "Show large wordmark",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Italian elegance, Brazilian sensuality. Born in Milan · Made in Brazil.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Extra text",
          "info": "Email and WhatsApp come from Theme settings › Contact & social."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
