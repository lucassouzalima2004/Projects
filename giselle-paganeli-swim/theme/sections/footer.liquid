<footer class="footer scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_newsletter -%}
    <div class="footer__newsletter page-width" data-reveal>
      <div class="footer__newsletter-intro">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="footer__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <div class="footer__newsletter-text rte">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}
      </div>
      {% render 'newsletter-form', id: 'FooterNewsletter', tags: 'newsletter,footer' %}
    </div>
  {%- endif -%}

  <div class="footer__grid page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__col footer__col--brand" {{ block.shopify_attributes }}>
            <a href="{{ routes.root_url }}" class="logo logo--footer">{%- render 'wordmark', full: true -%}</a>
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {% render 'social-links' %}
          </div>
        {%- when 'menu' -%}
          {%- assign footer_menu = block.settings.menu -%}
          {%- if footer_menu.links.size > 0 -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | default: footer_menu.title | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | default: footer_menu.title }}</h2>
              <ul class="footer__links" role="list">
                {%- for link in footer_menu.links -%}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- when 'account' -%}
          {%- if shop.customer_accounts_enabled -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <ul class="footer__links" role="list">
                <li><a href="{{ routes.account_url }}">{{ 'sections.footer.account' | t }}</a></li>
                <li><a href="{{ routes.account_url }}#orders">{{ 'sections.footer.orders' | t }}</a></li>
                <li><a href="{{ block.settings.track_link | default: routes.account_url }}">{{ 'sections.footer.track' | t }}</a></li>
              </ul>
            </nav>
          {%- endif -%}
        {%- when 'contact' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul class="footer__links footer__links--plain" role="list">
              {%- if settings.contact_phone != blank -%}
                {%- assign phones = settings.contact_phone | split: ',' -%}
                {%- for phone in phones -%}
                  {%- assign phone_label = phone | strip -%}
                  {%- assign phone_link = phone_label | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' -%}
                  <li><a href="tel:{{ phone_link }}">{{ phone_label }}</a></li>
                {%- endfor -%}
              {%- endif -%}
              {%- if settings.whatsapp_number != blank -%}
                <li><a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">WhatsApp</a></li>
              {%- endif -%}
              {%- if settings.contact_email != blank -%}
                <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
              {%- endif -%}
              {%- if block.settings.contact_page != blank -%}
                <li><a href="{{ block.settings.contact_page.url }}">{{ 'sections.footer.write' | t }}</a></li>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <li class="footer__text rte">{{ block.settings.text }}</li>
              {%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom page-width">
    {%- if section.settings.show_localization -%}
      {% render 'localization-form', id: 'Footer', class: 'localization localization--footer' %}
    {%- endif -%}
    <p class="footer__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- for link in section.settings.legal_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </p>
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payments" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if section.settings.show_big_wordmark -%}
    <div class="footer__giant" aria-hidden="true">
      {%- if settings.logo == blank and settings.logo_style == 'signature' -%}
        <svg class="footer__giant-signature" viewBox="0 0 1030 258.7" focusable="false"><use href="#gp-signature"></use></svg>
      {%- else -%}
        <span>{{ settings.wordmark_name | default: shop.name }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "pearl", "label": "White" },
        { "value": "ivory", "label": "Light grey" },
        { "value": "sand", "label": "Grey" },
        { "value": "cafe", "label": "Ink" },
        { "value": "garden", "label": "Charcoal" },
        { "value": "nero", "label": "Black" }
      ],
      "default": "pearl"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter sign-up",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the Garden"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Text",
      "default": "<p>Private previews, travel notes and the first look at every new chapter.</p>"
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country and language selectors",
      "default": true
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_big_wordmark",
      "label": "Show large signature",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Italian elegance, Brazilian sensuality. Born in Milan · Made in Brazil.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "account",
      "name": "Account links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "My account"
        },
        {
          "type": "paragraph",
          "content": "Links to the account (sign in or create one), the orders and order tracking. Shown when customer accounts are on."
        },
        {
          "type": "url",
          "id": "track_link",
          "label": "Order tracking link",
          "info": "Leave empty to open the account, where each order shows its tracking."
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "paragraph",
          "content": "Phone numbers, WhatsApp and email come from Theme settings › Contact & social. No address is shown."
        },
        {
          "type": "page",
          "id": "contact_page",
          "label": "Contact page"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Extra text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "account" },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
