{%- comment -%}
  A concept photo in the middle of the page with words at its sides ("Born in Milan · Made in Brazil").
{%- endcomment -%}
{%- liquid
  case section.settings.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '4 / 5'
  endcase
  assign media_tag = 'div'
  if section.settings.link != blank
    assign media_tag = 'a'
  endif
-%}
<section class="words scheme-{{ section.settings.color_scheme }} words--{{ section.settings.width }}">
  <div class="words__inner page-width" data-reveal>
    {%- if section.settings.text_left != blank -%}
      <p class="words__text words__text--left">{{ section.settings.text_left }}</p>
    {%- endif -%}
    <{{ media_tag }}
      class="words__media{% if section.settings.black_and_white %} is-mono{% endif %}"
      style="--words-ratio: {{ ratio }};"
      {% if section.settings.link != blank %}
        href="{{ section.settings.link }}"
        aria-label="{{ section.settings.text_left | append: ' ' | append: section.settings.text_right | strip | escape }}"
      {% endif %}
    >
      {%- render 'media',
        image: section.settings.image,
        artwork: section.settings.artwork,
        sizes: '(min-width: 990px) 40vw, 90vw',
        widths: '480, 720, 960, 1280, 1600',
        alt: section.settings.image.alt
      -%}
    </{{ media_tag }}>
    {%- if section.settings.text_right != blank -%}
      <p class="words__text words__text--right">{{ section.settings.text_right }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with side words",
  "tag": "div",
  "class": "section-words",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Artwork until an image is chosen",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "garden", "label": "The Garden" },
        { "value": "lake", "label": "Lake and mountain" },
        { "value": "canopy", "label": "Vines" },
        { "value": "palm", "label": "Palms" },
        { "value": "valley", "label": "Valley" },
        { "value": "flowers", "label": "Flowers" },
        { "value": "stream", "label": "Stream" },
        { "value": "bloom", "label": "Bloom" }
      ],
      "default": "palm"
    },
    {
      "type": "checkbox",
      "id": "black_and_white",
      "label": "Show the image in black and white",
      "default": true
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Image size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "text_left",
      "label": "Words on the left",
      "default": "Born in Milan"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Words on the right",
      "default": "Made in Brazil"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Opens when the image is clicked."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "pearl", "label": "White" },
        { "value": "ivory", "label": "Light grey" },
        { "value": "sand", "label": "Grey" },
        { "value": "cafe", "label": "Ink" },
        { "value": "garden", "label": "Charcoal" },
        { "value": "nero", "label": "Black" }
      ],
      "default": "pearl"
    }
  ],
  "presets": [
    {
      "name": "Image with side words"
    }
  ]
}
{% endschema %}
