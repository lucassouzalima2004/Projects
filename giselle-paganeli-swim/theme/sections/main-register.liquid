<section class="account-form page-width page-width--narrow">
  <div class="account-form__card">
    {%- render 'icon', name: 'clover' -%}
    <h1 class="page-hero__title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span>{{ 'customer.register.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span>{{ 'customer.register.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label class="field"><span>{{ 'customer.login.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span>{{ 'customer.login.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer register",
  "settings": []
}
{% endschema %}
