{%- liquid
  assign form_id = 'Newsletter-' | append: section.id
  assign has_media = false
  if section.settings.image != blank or section.settings.artwork != 'none'
    assign has_media = true
  endif
-%}
<section class="newsletter scheme-{{ section.settings.color_scheme }}{% if has_media %} newsletter--media{% endif %}">
  {%- if has_media -%}
    <div class="newsletter__bg">
      {%- render 'media', image: section.settings.image, artwork: section.settings.artwork, sizes: '100vw' -%}
    </div>
  {%- endif -%}
  <div class="newsletter__inner" data-reveal>
    {%- render 'icon', name: 'clover' -%}
    {%- if section.settings.overline != blank -%}
      <p class="overline">{{ section.settings.overline }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte newsletter__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {% render 'newsletter-form', id: form_id, tags: section.settings.tags, button_label: section.settings.button_label, consent: section.settings.consent %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Background artwork",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Garden"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Be the first to know about new pieces, private previews and travel notes.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "richtext",
      "id": "consent",
      "label": "Consent text",
      "default": "<p>I agree to receive emails from Giselle Paganeli Swim and accept the privacy policy. I can unsubscribe at any time.</p>"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Customer tags",
      "default": "newsletter",
      "info": "Added to the customer record, useful to segment campaigns."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "sand"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
