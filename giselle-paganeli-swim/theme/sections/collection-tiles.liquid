{%- comment -%}
  Large category images with the name across the middle, side by side: the quickest way into the shop.
{%- endcomment -%}
{%- liquid
  case section.settings.ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    else
      assign ratio = '2 / 3'
  endcase
-%}
<section class="tiles scheme-{{ section.settings.color_scheme }}{% if section.settings.full_width %} tiles--full{% endif %}">
  {%- if section.settings.overline != blank or section.settings.heading != blank -%}
    <header class="section-head page-width">
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="tiles__grid{% unless section.settings.full_width %} page-width{% endunless %}" style="--tile-ratio: {{ ratio }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign link = block.settings.link | default: collection.url | default: routes.all_products_collection_url
        assign label = block.settings.label | default: collection.title
        assign image = block.settings.image | default: collection.featured_image
      -%}
      <a href="{{ link }}" class="tile-card" style="--i: {{ forloop.index0 }};" data-reveal {{ block.shopify_attributes }}>
        <span class="tile-card__media">
          {%- render 'media',
            image: image,
            artwork: block.settings.artwork,
            sizes: '(min-width: 990px) 25vw, 50vw',
            widths: '360, 540, 720, 960, 1200',
            alt: ''
          -%}
        </span>
        <span class="tile-card__label">{{ label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category images",
  "tag": "div",
  "class": "section-tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "tall", "label": "Tall (2:3)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" }
      ],
      "default": "tall"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Edge to edge",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "pearl", "label": "White" },
        { "value": "ivory", "label": "Light grey" },
        { "value": "sand", "label": "Grey" },
        { "value": "cafe", "label": "Ink" },
        { "value": "garden", "label": "Charcoal" },
        { "value": "nero", "label": "Black" }
      ],
      "default": "pearl"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Name on the image",
          "info": "Leave empty to use the collection name."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the collection image. Portrait, 1200 px wide or more."
        },
        {
          "type": "select",
          "id": "artwork",
          "label": "Artwork until an image is chosen",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "garden", "label": "The Garden" },
            { "value": "lake", "label": "Lake and mountain" },
            { "value": "canopy", "label": "Vines" },
            { "value": "palm", "label": "Palms" },
            { "value": "valley", "label": "Valley" },
            { "value": "flowers", "label": "Flowers" },
            { "value": "stream", "label": "Stream" },
            { "value": "bloom", "label": "Bloom" }
          ],
          "default": "palm"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to open the collection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category images",
      "blocks": [
        { "type": "tile", "settings": { "label": "Bikinis", "artwork": "canopy" } },
        { "type": "tile", "settings": { "label": "Swimsuits", "artwork": "flowers" } },
        { "type": "tile", "settings": { "label": "Resortwear", "artwork": "palm" } },
        { "type": "tile", "settings": { "label": "New in", "artwork": "bloom" } }
      ]
    }
  ]
}
{% endschema %}
