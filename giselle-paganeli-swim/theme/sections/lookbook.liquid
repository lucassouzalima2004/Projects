<section class="lookbook scheme-{{ section.settings.color_scheme }} lookbook--{{ section.settings.layout }}">
  <div class="lookbook__inner page-width">
    <div class="lookbook__visual" data-reveal>
      <div class="lookbook__media">
        {%- render 'media',
          image: section.settings.image,
          artwork: section.settings.artwork,
          sizes: '(min-width: 990px) 55vw, 100vw',
          widths: '540, 720, 960, 1280, 1600',
          alt: section.settings.heading
        -%}
      </div>
      {%- for block in section.blocks -%}
        {%- liquid
          assign spot_product = block.settings.product
          if spot_product == blank
            assign spot_product = collections.all.products[forloop.index0]
          endif
        -%}
        {%- if spot_product != blank -%}
          <look-hotspot class="hotspot" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="hotspot__dot"
              aria-expanded="false"
              aria-controls="Hotspot-{{ section.id }}-{{ forloop.index }}"
            >
              <span class="hotspot__num">{{ forloop.index }}</span>
              <span class="visually-hidden">{{ spot_product.title }}</span>
            </button>
            <div class="hotspot__card" id="Hotspot-{{ section.id }}-{{ forloop.index }}" hidden>
              <a href="{{ spot_product.url }}" class="hotspot__link">
                <span class="hotspot__media">
                  {%- if spot_product.featured_media -%}
                    {{ spot_product.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', alt: spot_product.title, sizes: '120px', widths: '150, 300' }}
                  {%- endif -%}
                </span>
                <span class="hotspot__text">
                  <span class="hotspot__title">{{ spot_product.title }}</span>
                  {%- render 'price', product: spot_product -%}
                  <span class="link link--small">{{ 'sections.lookbook.shop' | t }}</span>
                </span>
              </a>
            </div>
          </look-hotspot>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="lookbook__content" data-reveal>
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <ol class="lookbook__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign spot_product = block.settings.product
            if spot_product == blank
              assign spot_product = collections.all.products[forloop.index0]
            endif
          -%}
          {%- if spot_product != blank -%}
            <li>
              <a href="{{ spot_product.url }}" class="lookbook__item">
                <span class="lookbook__num">{{ forloop.index }}</span>
                <span class="lookbook__name">{{ spot_product.title }}</span>
                <span class="lookbook__price">{{ spot_product.price | money }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the look",
  "tag": "div",
  "class": "section-lookbook",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Artwork until an image is chosen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "stream"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "image-left",
          "label": "Left"
        },
        {
          "value": "image-right",
          "label": "Right"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "By the water"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tap the points on the image to discover each piece.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "ivory"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product point",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x": 34,
            "y": 42
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 62,
            "y": 58
          }
        }
      ]
    }
  ]
}
{% endschema %}
