<section class="page-hero scheme-{{ section.settings.color_scheme }}">
  <div class="page-hero__inner page-width" data-reveal>
    {%- render 'icon', name: 'clover' -%}
    {%- if section.settings.overline != blank -%}
      <p class="overline">{{ section.settings.overline }}</p>
    {%- endif -%}
    <h1 class="page-hero__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="page-hero__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page heading",
  "tag": "div",
  "class": "section-page-hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "presets": [
    {
      "name": "Page heading"
    }
  ]
}
{% endschema %}
