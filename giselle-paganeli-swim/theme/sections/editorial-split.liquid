{%- liquid
  assign heading_tag = 'h2'
  if section.settings.heading_as_title
    assign heading_tag = 'h1'
  endif
-%}
<section class="split scheme-{{ section.settings.color_scheme }} split--{{ section.settings.layout }} split--{{ section.settings.shape }}">
  <div class="split__inner page-width">
    <div class="split__visual" data-reveal>
      <div class="split__media{% if section.settings.shape == 'arch' %} arch{% endif %}">
        {%- render 'media',
          image: section.settings.image,
          artwork: section.settings.artwork,
          sizes: '(min-width: 990px) 45vw, 100vw',
          widths: '480, 720, 960, 1280',
          alt: section.settings.heading
        -%}
      </div>
      {%- if section.settings.image_2 != blank or section.settings.artwork_2 != 'none' -%}
        <div class="split__inset">
          {%- render 'media',
            image: section.settings.image_2,
            artwork: section.settings.artwork_2,
            sizes: '(min-width: 990px) 18vw, 40vw',
            widths: '240, 360, 480, 720'
          -%}
        </div>
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="split__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
    <div class="split__content" data-reveal>
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="split__title h2">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="split__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}
        <p class="split__signature">{{ section.settings.signature }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}" class="link link--arrow">
          <span>{{ section.settings.link_label }}</span>
          {%- render 'icon', name: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "section-split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Artwork until an image is chosen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "lake"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Image shape",
      "options": [
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "arch"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image",
      "info": "Small image overlapping the first one."
    },
    {
      "type": "select",
      "id": "artwork_2",
      "label": "Second artwork",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "image-left",
          "label": "Left"
        },
        {
          "value": "image-right",
          "label": "Right"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "The Garden of Eden 2027"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A refuge of beauty and calm"
    },
    {
      "type": "checkbox",
      "id": "heading_as_title",
      "label": "Use heading as page title (H1)",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Water, gardens, stone and skin. A collection drawn from the light of Lake Como and the warmth of Brazil.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
