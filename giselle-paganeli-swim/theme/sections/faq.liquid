<section class="faq scheme-{{ section.settings.color_scheme }}">
  <faq-list class="faq__inner page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <header class="section-head" data-reveal>
        {%- if section.settings.overline != blank -%}
          <p class="overline">{{ section.settings.overline }}</p>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}

    {%- if section.settings.show_search -%}
      <div class="faq__search" data-reveal>
        <label for="FaqSearch-{{ section.id }}" class="visually-hidden">{{ 'sections.faq.search' | t }}</label>
        {%- render 'icon', name: 'search' -%}
        <input id="FaqSearch-{{ section.id }}" type="search" placeholder="{{ 'sections.faq.search' | t }}" autocomplete="off" data-faq-search>
      </div>
      <p class="faq__empty" data-faq-empty hidden>{{ 'sections.faq.no_results' | t }}</p>
    {%- endif -%}

    <div class="faq__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            <h3 class="faq__group" data-faq-group {{ block.shopify_attributes }}>{{ block.settings.heading }}</h3>
          {%- when 'question' -%}
            <details class="accordion" data-faq-item {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{{ block.settings.question }}</span>
                {%- render 'icon', name: 'plus' -%}
              </summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </faq-list>
</section>

{%- assign questions = section.blocks | where: 'type', 'question' -%}
{%- if questions.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in questions -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "Client care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search field",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "White"
        },
        {
          "value": "ivory",
          "label": "Light grey"
        },
        {
          "value": "sand",
          "label": "Grey"
        },
        {
          "value": "cafe",
          "label": "Ink"
        },
        {
          "value": "garden",
          "label": "Charcoal"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Orders"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "When will my order ship?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add the answer that matches your shipping policy.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "group"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
