<section class="gate">
  <div class="gate__bg">
    {%- render 'media', image: section.settings.image, artwork: section.settings.artwork, sizes: '100vw', priority: true -%}
  </div>
  <div class="gate__veil"></div>
  <div class="gate__inner">
    <div class="gate__logo">{%- render 'wordmark', tone: 'light' -%}</div>

    <div class="gate__card arch-card" data-reveal>
      {%- render 'icon', name: 'clover' -%}
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      <h1 class="gate__title">{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="gate__text">{{ shop.password_message }}</p>
      {%- elsif section.settings.text != blank -%}
        <div class="gate__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.launch_date != blank -%}
        <countdown-timer class="countdown" data-date="{{ section.settings.launch_date }}">
          <span><b data-unit="days">00</b><small>{{ 'sections.password.days' | t }}</small></span>
          <span><b data-unit="hours">00</b><small>{{ 'sections.password.hours' | t }}</small></span>
          <span><b data-unit="minutes">00</b><small>{{ 'sections.password.minutes' | t }}</small></span>
          <span><b data-unit="seconds">00</b><small>{{ 'sections.password.seconds' | t }}</small></span>
        </countdown-timer>
      {%- endif -%}

      {% render 'newsletter-form', id: 'GateNewsletter', tags: 'prelaunch', button_label: section.settings.button_label %}
    </div>

    <div class="gate__foot">
      {% render 'social-links' %}
      {%- if settings.signature != blank -%}
        <p class="signature">{{ settings.signature }}</p>
      {%- endif -%}
      <button type="button" class="link link--small" data-gate-open>{{ 'sections.password.owner' | t }}</button>
    </div>
  </div>

  <dialog class="gate__dialog" data-gate-dialog>
    {%- form 'storefront_password', class: 'gate__form' -%}
      <p class="overline">{{ 'sections.password.owner' | t }}</p>
      {%- if form.errors -%}
        <div class="form-message form-message--error" data-gate-error>{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="field">
        <span>{{ 'sections.password.label' | t }}</span>
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button type="submit" class="button">{{ 'sections.password.enter' | t }}</button>
      <button type="button" class="link link--small" data-gate-close>{{ 'accessibility.close' | t }}</button>
    {%- endform -%}
  </dialog>
</section>

{% schema %}
{
  "name": "Pre-launch",
  "tag": "div",
  "class": "section-gate",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "artwork",
      "label": "Artwork",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "garden"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "The Garden of Eden 2027"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enter the Garden"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Hidden when a message is set in Online Store › Preferences › Password protection.",
      "default": "<p>A new chapter of Giselle Paganeli Swim is about to open. Leave your email to receive the invitation.</p>"
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch date",
      "info": "Format YYYY-MM-DD or YYYY-MM-DDTHH:MM. Leave empty to hide the countdown."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    }
  ]
}
{% endschema %}
