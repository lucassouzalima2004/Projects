<section class="help scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section-head" data-reveal>
        {%- if section.settings.overline != blank -%}
          <p class="overline">{{ section.settings.overline }}</p>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}
    <ul class="help__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="help__item" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="help__card">
            <span class="help__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="help__title">{{ block.settings.heading }}</span>
            {%- if block.settings.text != blank -%}
              <span class="help__text">{{ block.settings.text }}</span>
            {%- endif -%}
            <span class="help__arrow">{%- render 'icon', name: 'arrow' -%}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Help topics",
  "tag": "div",
  "class": "section-help",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help?"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Size guide"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Find your perfect fit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help topics",
      "blocks": [
        {
          "type": "topic",
          "settings": {
            "heading": "Size guide",
            "text": "Find your perfect fit"
          }
        },
        {
          "type": "topic",
          "settings": {
            "heading": "Care",
            "text": "Keep every piece beautiful"
          }
        },
        {
          "type": "topic",
          "settings": {
            "heading": "Shipping & returns",
            "text": "Delivery times and exchanges"
          }
        },
        {
          "type": "topic",
          "settings": {
            "heading": "Contact",
            "text": "Write to our client care"
          }
        }
      ]
    }
  ]
}
{% endschema %}
