{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign customer_topics = section.settings.customer_topics | split: ','
  assign business_topics = section.settings.business_topics | split: ','
-%}
<section class="contact scheme-{{ section.settings.color_scheme }}">
  <div class="contact__inner page-width">
    <div class="contact__intro" data-reveal>
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <ul class="contact__channels" role="list">
        {%- if settings.contact_email != blank -%}
          <li>
            <span class="overline">{{ 'sections.contact.email' | t }}</span>
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          </li>
        {%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <li>
            <span class="overline">WhatsApp</span>
            <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{{ 'sections.contact.whatsapp' | t }}</a>
          </li>
        {%- endif -%}
        {%- if settings.social_instagram != blank -%}
          <li>
            <span class="overline">Instagram</span>
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{{ 'sections.contact.instagram' | t }}</a>
          </li>
        {%- endif -%}
      </ul>
      {%- if section.settings.business_text != blank -%}
        <div class="contact__business rte">{{ section.settings.business_text }}</div>
      {%- endif -%}
    </div>

    <contact-form class="contact__form" data-reveal>
      {%- form 'contact', id: form_id, class: 'form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" tabindex="-1">
            {%- render 'icon', name: 'check' -%}
            <span>{{ 'sections.contact.success' | t }}</span>
          </p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="form__grid">
          <div class="field">
            <label for="{{ form_id }}-name">{{ 'sections.contact.name' | t }}</label>
            <input id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
          </div>
          <div class="field">
            <label for="{{ form_id }}-email">{{ 'sections.contact.email' | t }}</label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
          </div>
          <div class="field">
            <label for="{{ form_id }}-phone">{{ 'sections.contact.phone' | t }} <span class="field__optional">{{ 'sections.contact.optional' | t }}</span></label>
            <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          <div class="field">
            <label for="{{ form_id }}-topic">{{ 'sections.contact.topic' | t }}</label>
            <select id="{{ form_id }}-topic" name="contact[topic]" data-topic required>
              <option value="" disabled selected>{{ 'sections.contact.topic_placeholder' | t }}</option>
              <optgroup label="{{ 'sections.contact.customer_care' | t }}">
                {%- for topic in customer_topics -%}
                  <option value="{{ topic | strip | escape }}">{{ topic | strip }}</option>
                {%- endfor -%}
              </optgroup>
              <optgroup label="{{ 'sections.contact.business' | t }}">
                {%- for topic in business_topics -%}
                  <option value="{{ topic | strip | escape }}" data-business>{{ topic | strip }}</option>
                {%- endfor -%}
              </optgroup>
            </select>
          </div>
          <div class="field field--full" data-business-field hidden>
            <label for="{{ form_id }}-company">{{ 'sections.contact.company' | t }}</label>
            <input id="{{ form_id }}-company" type="text" name="contact[company]" autocomplete="organization" disabled>
          </div>
          <div class="field field--full" data-business-field hidden>
            <label for="{{ form_id }}-website">{{ 'sections.contact.website' | t }} <span class="field__optional">{{ 'sections.contact.optional' | t }}</span></label>
            <input id="{{ form_id }}-website" type="text" name="contact[website]" autocomplete="url" disabled>
          </div>
          <div class="field field--full">
            <label for="{{ form_id }}-message">{{ 'sections.contact.message' | t }}</label>
            <textarea id="{{ form_id }}-message" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
        </div>
        <label class="consent">
          <input type="checkbox" required>
          <span class="consent__text">{{ 'sections.contact.consent' | t }}</span>
        </label>
        <button type="submit" class="button">{{ 'sections.contact.submit' | t }}</button>
      {%- endform -%}
    </contact-form>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "class": "section-contact",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to us"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our client care team answers within two working days.</p>"
    },
    {
      "type": "text",
      "id": "customer_topics",
      "label": "Customer topics",
      "info": "Separated by commas.",
      "default": "Orders and delivery, Sizes and fit, Exchanges and returns, Product care, Other"
    },
    {
      "type": "text",
      "id": "business_topics",
      "label": "Business topics",
      "info": "Separated by commas. These show the company field.",
      "default": "Boutiques and retailers, Resorts and hotels, Spas and wellness, Press and collaborations"
    },
    {
      "type": "richtext",
      "id": "business_text",
      "label": "Business note",
      "default": "<p><strong>Boutiques, resorts and spas</strong><br>Tell us about your property and we will share the wholesale line sheet.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "White"
        },
        {
          "value": "ivory",
          "label": "Light grey"
        },
        {
          "value": "sand",
          "label": "Grey"
        },
        {
          "value": "cafe",
          "label": "Ink"
        },
        {
          "value": "garden",
          "label": "Charcoal"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
