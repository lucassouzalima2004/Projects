{%- comment -%}
  Full-screen campaign slideshow. Each slide can carry a phrase split across the image (left and right),
  a heading and a button; the whole slide links to its collection. On the home page the header sits on top
  of the first slide.
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
  assign fallback_link = routes.all_products_collection_url
-%}
<slide-show
  class="slideshow slideshow--{{ section.settings.height }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval }}"
  style="--veil: {{ section.settings.veil | divided_by: 100.0 }}; --interval: {{ section.settings.interval | times: 1000 }}ms;"
  {% if slide_count > 1 %}
    aria-roledescription="carousel"
    aria-label="{{ 'sections.slideshow.label' | t | escape }}"
  {% endif %}
>
  <div class="slideshow__slides">
    {%- for block in section.blocks -%}
      {%- liquid
        assign loading = 'lazy'
        assign priority = 'auto'
        if forloop.first
          assign loading = 'eager'
          assign priority = 'high'
        endif
        assign link = block.settings.link
        if link == blank and block.settings.button_label != blank
          assign link = fallback_link
        endif
        assign inner_tag = 'div'
        if link != blank
          assign inner_tag = 'a'
        endif
        assign image_alt = block.settings.image.alt | default: block.settings.heading
        assign slide_label = 'sections.slideshow.slide' | t: index: forloop.index, count: slide_count
      -%}
      <div
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        class="slide{% if forloop.first %} is-active{% endif %}"
        style="--focal: {{ block.settings.focal_x }}% {{ block.settings.focal_y }}%;"
        data-slide
        {% if slide_count > 1 %}
          role="group" aria-roledescription="slide" aria-label="{{ slide_label | escape }}"
        {% endif %}
        {% unless forloop.first %}
          inert
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        <{{ inner_tag }}
          class="slide__inner"
          {% if link != blank %}
            href="{{ link }}"
          {% endif %}
        >
        <div class="slide__media">
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ block.settings.image_mobile | image_url: width: 1500 }} 1500w"
                  sizes="100vw"
                >
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  widths: '750, 1100, 1500, 2000, 2600, 3000',
                  sizes: '100vw',
                  loading: loading,
                  fetchpriority: priority,
                  class: 'slide__img',
                  alt: image_alt
              }}
            </picture>
          {%- else -%}
            {%- render 'media',
              image: block.settings.image_mobile,
              artwork: block.settings.artwork,
              sizes: '100vw',
              priority: forloop.first,
              class: 'slide__img',
              alt: block.settings.heading
            -%}
          {%- endif -%}
        </div>
        <span class="slide__veil" aria-hidden="true"></span>
        {%- if block.settings.text_left != blank or block.settings.text_right != blank -%}
          <p class="slide__split">
            <span>{{ block.settings.text_left }}</span>
            <span>{{ block.settings.text_right }}</span>
          </p>
        {%- endif -%}
        {%- if block.settings.heading != blank or block.settings.button_label != blank -%}
          <div class="slide__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="slide__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="button button--light slide__button">{{ block.settings.button_label }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        </{{ inner_tag }}>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="slideshow__controls">
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="slideshow__dot"
            data-go="{{ forloop.index0 }}"
            aria-controls="Slide-{{ section.id }}-{{ forloop.index }}"
            aria-label="{{ 'sections.slideshow.go_to' | t: index: forloop.index | escape }}"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
          >
            <span></span>
          </button>
        {%- endfor -%}
      </div>
      {%- if section.settings.autoplay -%}
        <button
          type="button"
          class="slideshow__toggle"
          data-toggle
          data-label-pause="{{ 'sections.slideshow.pause' | t | escape }}"
          data-label-play="{{ 'sections.slideshow.play' | t | escape }}"
          aria-label="{{ 'sections.slideshow.pause' | t | escape }}"
        >
          {%- render 'icon', name: 'pause' -%}
          {%- render 'icon', name: 'play' -%}
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</slide-show>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Change slides automatically",
      "info": "Pauses while the visitor points at it, and for visitors who prefer reduced motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Time on each slide",
      "default": 6
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "veil",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Darken images",
      "info": "Keeps the white text readable on light photos.",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Landscape, 2400 px wide or more."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Portrait 4:5 or 2:3."
        },
        {
          "type": "select",
          "id": "artwork",
          "label": "Artwork until an image is chosen",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "garden", "label": "The Garden" },
            { "value": "lake", "label": "Lake and mountain" },
            { "value": "canopy", "label": "Vines" },
            { "value": "palm", "label": "Palms" },
            { "value": "valley", "label": "Valley" },
            { "value": "flowers", "label": "Flowers" },
            { "value": "stream", "label": "Stream" },
            { "value": "bloom", "label": "Bloom" }
          ],
          "default": "garden"
        },
        {
          "type": "range",
          "id": "focal_x",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Focal point, horizontal",
          "default": 50
        },
        {
          "type": "range",
          "id": "focal_y",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Focal point, vertical",
          "default": 40
        },
        {
          "type": "text",
          "id": "text_left",
          "label": "Text on the left",
          "default": "Born in Milan"
        },
        {
          "type": "text",
          "id": "text_right",
          "label": "Text on the right",
          "default": "Made in Brazil"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The whole slide opens this page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Embrace your oasis",
            "button_label": "Discover the collection"
          }
        },
        {
          "type": "slide",
          "settings": {
            "artwork": "lake",
            "text_left": "The Garden",
            "text_right": "of Eden"
          }
        }
      ]
    }
  ]
}
{% endschema %}
