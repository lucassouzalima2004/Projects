{%- liquid
  assign sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: section.settings.columns | append: '), 70vw'
-%}
<section class="featured scheme-{{ section.settings.color_scheme }} featured--{{ section.settings.mobile_layout }}">
  <div class="page-width">
    {%- if section.settings.overline != blank or section.settings.heading != blank -%}
      <header class="section-head" data-reveal>
        {%- if section.settings.overline != blank -%}
          <p class="overline">{{ section.settings.overline }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <collection-tabs class="tabs">
      {%- if section.blocks.size > 1 -%}
        <div class="tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}" data-reveal>
          {%- for block in section.blocks -%}
            {%- assign tab_collection = block.settings.collection -%}
            {%- if tab_collection == blank -%}
              {%- assign tab_collection = collections[block.settings.handle] -%}
            {%- endif -%}
            <button
              type="button"
              class="tabs__tab"
              role="tab"
              id="Tab-{{ section.id }}-{{ forloop.index }}"
              aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | default: tab_collection.title -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign tab_collection = block.settings.collection
          if tab_collection == blank
            assign tab_collection = collections[block.settings.handle]
          endif
        -%}
        <div
          class="tabs__panel"
          role="tabpanel"
          id="Panel-{{ section.id }}-{{ forloop.index }}"
          aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          <ul class="product-grid" role="list" style="--cols: {{ section.settings.columns }};">
            {%- for product in tab_collection.products limit: section.settings.limit -%}
              <li class="product-grid__item" data-reveal style="--i: {{ forloop.index0 | modulo: 4 }};">
                {%- render 'product-card', product: product, sizes: sizes -%}
              </li>
            {%- else -%}
              {%- for i in (1..4) -%}
                <li class="product-grid__item">
                  <div class="card card--placeholder">
                    <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'card__img placeholder-svg' }}</div>
                    <div class="card__info"><p class="card__title">{{ 'sections.featured_collection.placeholder' | t }}</p></div>
                  </div>
                </li>
              {%- endfor -%}
            {%- endfor -%}
          </ul>
          {%- if section.settings.show_view_all and tab_collection.products_count > 0 -%}
            <div class="section-foot">
              <a href="{{ tab_collection.url }}" class="link link--arrow">
                <span>{{ 'sections.featured_collection.view_all' | t: title: tab_collection.title }}</span>
                {%- render 'icon', name: 'arrow' -%}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </collection-tabs>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "class": "section-featured",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enter the Garden"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products per tab",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "On mobile",
      "options": [
        {
          "value": "carousel",
          "label": "Swipe"
        },
        {
          "value": "grid",
          "label": "Two columns"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “view all” link",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bikinis"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle",
          "default": "bikinis",
          "info": "Used while no collection is chosen above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "Bikinis",
            "handle": "bikinis"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Swimsuits",
            "handle": "swimsuits"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Resortwear",
            "handle": "resortwear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
