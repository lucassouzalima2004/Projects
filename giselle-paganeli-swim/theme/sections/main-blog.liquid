<section class="journal scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <header class="section-head" data-reveal>
      {%- render 'icon', name: 'clover' -%}
      <h1 class="page-hero__title">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      <ul class="journal__grid" role="list">
        {%- for article in blog.articles -%}
          <li data-reveal style="--i: {{ forloop.index0 | modulo: 3 }};">
            <a href="{{ article.url }}" class="journal-card">
              <span class="journal-card__media{% if forloop.first %} arch{% endif %}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '540, 720, 960, 1200', alt: article.title }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="overline">{{ article.published_at | time_tag: format: 'date' }}</span>
              <span class="journal-card__title">{{ article.title }}</span>
              <span class="journal-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "tag": "div",
  "class": "section-journal",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        }
      ],
      "default": "pearl"
    }
  ]
}
{% endschema %}
