<section class="duo scheme-{{ section.settings.color_scheme }}">
  <div class="duo__inner page-width">
    <figure class="duo__item duo__item--left" data-reveal>
      <div class="duo__media arch">
        {%- render 'media',
          image: section.settings.image_left,
          artwork: section.settings.artwork_left,
          sizes: '(min-width: 990px) 28vw, 45vw',
          widths: '360, 540, 720, 960',
          alt: section.settings.label_left
        -%}
      </div>
      {%- if section.settings.label_left != blank -%}
        <figcaption class="duo__label">{{ section.settings.label_left }}</figcaption>
      {%- endif -%}
    </figure>

    <div class="duo__center" data-reveal>
      {%- render 'icon', name: 'clover' -%}
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2 duo__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte duo__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}" class="link link--arrow">
          <span>{{ section.settings.link_label }}</span>
          {%- render 'icon', name: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>

    <figure class="duo__item duo__item--right" data-reveal>
      <div class="duo__media arch">
        {%- render 'media',
          image: section.settings.image_right,
          artwork: section.settings.artwork_right,
          sizes: '(min-width: 990px) 28vw, 45vw',
          widths: '360, 540, 720, 960',
          alt: section.settings.label_right
        -%}
      </div>
      {%- if section.settings.label_right != blank -%}
        <figcaption class="duo__label">{{ section.settings.label_right }}</figcaption>
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Two origins",
  "tag": "div",
  "class": "section-duo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image"
    },
    {
      "type": "select",
      "id": "artwork_left",
      "label": "Left artwork",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "canopy"
    },
    {
      "type": "text",
      "id": "label_left",
      "label": "Left caption",
      "default": "Born in Milan"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right image"
    },
    {
      "type": "select",
      "id": "artwork_right",
      "label": "Right artwork",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "garden",
          "label": "The Garden"
        },
        {
          "value": "lake",
          "label": "Lake and mountain"
        },
        {
          "value": "canopy",
          "label": "Vines"
        },
        {
          "value": "palm",
          "label": "Palms"
        },
        {
          "value": "valley",
          "label": "Valley"
        },
        {
          "value": "flowers",
          "label": "Flowers"
        },
        {
          "value": "stream",
          "label": "Stream"
        },
        {
          "value": "bloom",
          "label": "Bloom"
        }
      ],
      "default": "palm"
    },
    {
      "type": "text",
      "id": "label_right",
      "label": "Right caption",
      "default": "Made in Brazil"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "The Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two places, one oasis"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Conceived between the gardens of Milan and the shores of Lake Como, crafted in Brazil.</p>"
    },
    {
      "type": "text",
