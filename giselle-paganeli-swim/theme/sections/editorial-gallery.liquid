{%- liquid
  assign gallery_label = 'sections.gallery.label' | t
  if section.settings.heading != blank
    assign gallery_label = section.settings.heading
  endif
-%}
<section class="gallery scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.overline != blank or section.settings.heading != blank -%}
    <header class="section-head page-width" data-reveal>
      {%- if section.settings.overline != blank -%}
        <p class="overline">{{ section.settings.overline }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>
  {%- endif -%}

  <drag-gallery class="gallery__wrap">
    <ul class="gallery__track" role="list" tabindex="0" aria-label="{{ gallery_label | escape }}">
      {%- for block in section.blocks -%}
        <li class="gallery__item gallery__item--{{ block.settings.shape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="gallery__link" draggable="false">{%- endif -%}
          <div class="gallery__media">
            {%- render 'media',
              image: block.settings.image,
              artwork: block.settings.artwork,
              sizes: '(min-width: 990px) 34vw, 75vw',
              widths: '480, 720, 960, 1280',
              alt: block.settings.caption
            -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <p class="gallery__caption">{{ block.settings.caption }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="gallery__progress" aria-hidden="true"><span></span></div>
  </drag-gallery>

  {%- if section.settings.link_label != blank -%}
    <div class="section-foot page-width">
      <a href="{{ section.settings.link }}" class="link link--arrow">
        <span>{{ section.settings.link_label }}</span>
        {%- render 'icon', name: 'arrow' -%}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Editorial gallery",
  "tag": "div",
  "class": "section-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Water, stone and light"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "White"
        },
        {
          "value": "ivory",
          "label": "Light grey"
        },
        {
          "value": "sand",
          "label": "Grey"
        },
        {
          "value": "cafe",
          "label": "Ink"
        },
        {
          "value": "garden",
          "label": "Charcoal"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "artwork",
          "label": "Artwork until an image is chosen",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "garden",
              "label": "The Garden"
            },
            {
              "value": "lake",
              "label": "Lake and mountain"
            },
            {
              "value": "canopy",
              "label": "Vines"
            },
            {
              "value": "palm",
              "label": "Palms"
            },
            {
              "value": "valley",
              "label": "Valley"
            },
            {
              "value": "flowers",
              "label": "Flowers"
            },
            {
              "value": "stream",
              "label": "Stream"
            },
            {
              "value": "bloom",
              "label": "Bloom"
            }
          ],
          "default": "flowers"
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "options": [
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "square",
              "label": "Square"
            }
          ],
          "default": "portrait"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial gallery",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "artwork": "flowers",
            "shape": "portrait"
          }
        },
        {
          "type": "image",
          "settings": {
            "artwork": "stream",
            "shape": "landscape"
          }
        },
        {
          "type": "image",
          "settings": {
            "artwork": "lake",
            "shape": "square"
          }
        },
        {
          "type": "image",
          "settings": {
            "artwork": "canopy",
            "shape": "portrait"
          }
        }
      ]
    }
  ]
}
{% endschema %}
