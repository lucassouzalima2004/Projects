<section class="columns scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.overline != blank or section.settings.heading != blank -%}
      <header class="section-head" data-reveal>
        {%- if section.settings.overline != blank -%}
          <p class="overline">{{ section.settings.overline }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}
    <ul class="columns__grid" role="list" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="columns__item" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.artwork != 'none' -%}
            <div class="columns__media arch">
              {%- render 'media',
                image: block.settings.image,
                artwork: block.settings.artwork,
                sizes: '(min-width: 990px) 25vw, 80vw',
                widths: '360, 540, 720',
                alt: block.settings.heading
              -%}
            </div>
          {%- endif -%}
          {%- if block.settings.overline != blank -%}
            <p class="columns__num">{{ block.settings.overline }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="columns__title">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link }}" class="link link--arrow">
              <span>{{ block.settings.link_label }}</span>
              {%- render 'icon', name: 'arrow' -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Columns",
  "tag": "div",
  "class": "section-columns",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we believe"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        {
          "value": "pearl",
          "label": "Pearl"
        },
        {
          "value": "ivory",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "cafe",
          "label": "Café"
        },
        {
          "value": "garden",
          "label": "Garden green"
        },
        {
          "value": "nero",
          "label": "Black"
        }
      ],
      "default": "pearl"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "artwork",
          "label": "Artwork until an image is chosen",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "garden",
              "label": "The Garden"
            },
            {
              "value": "lake",
              "label": "Lake and mountain"
            },
            {
              "value": "canopy",
              "label": "Vines"
            },
            {
              "value": "palm",
              "label": "Palms"
            },
            {
              "value": "valley",
              "label": "Valley"
            },
            {
              "value": "flowers",
              "label": "Flowers"
            },
            {
              "value": "stream",
              "label": "Stream"
            },
            {
              "value": "bloom",
              "label": "Bloom"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "overline",
          "label": "Number or small heading",
          "default": "I"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quiet luxury"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe a value, a detail or a promise.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Columns",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
