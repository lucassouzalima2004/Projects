{%- layout none -%}
{%- assign gift_value = gift_card.initial_value | money -%}
{%- assign gift_expiry = gift_card.expires_on | date: '%d/%m/%Y' -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: gift_value, shop: shop.name }}</title>
    {% render 'theme-styles' %}
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>
  <body class="template-gift-card">
    {% render 'brand-sprite' %}
    <main class="gift-card page-width page-width--narrow">
      <div class="gift-card__logo">{% render 'wordmark' %}</div>
      {%- render 'icon', name: 'mark' -%}
      <h1 class="page-hero__title">{{ 'gift_cards.issued.subtext' | t }}</h1>
      <p class="gift-card__value">{{ gift_card.initial_value | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="form-message form-message--error">{{ 'gift_cards.issued.expired' | t }}</p>
      {%- endif -%}
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <div id="GiftCardQr" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
      {%- if gift_card.expires_on -%}
        <p>{{ 'gift_cards.issued.expires_on' | t: expires_on: gift_expiry }}</p>
      {%- endif -%}
      <p><a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a></p>
      <button type="button" class="link link--small" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('GiftCardQr');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
