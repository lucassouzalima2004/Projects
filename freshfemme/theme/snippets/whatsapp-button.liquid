{%- if settings.whatsapp_number != blank -%}
  {%- assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' -%}
  <a
    class="whatsapp"
    href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'general.whatsapp' | t }}"
  >
    {% render 'icon', name: 'whatsapp' %}
    <span class="whatsapp__label">{{ 'general.whatsapp_short' | t }}</span>
  </a>
{%- endif -%}
