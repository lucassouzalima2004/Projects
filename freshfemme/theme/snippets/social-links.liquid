{%- liquid
  assign networks = 'instagram,tiktok,youtube,facebook' | split: ','
-%}
{%- for network in networks -%}
  {%- assign key = 'social_' | append: network -%}
  {%- assign url = settings[key] -%}
  {%- if url != blank -%}
    <a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ network | capitalize }}">
      {% render 'icon', name: network %}
    </a>
  {%- endif -%}
{%- endfor -%}
