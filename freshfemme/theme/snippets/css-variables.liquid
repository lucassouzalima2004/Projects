{%- liquid
  assign heading_font = settings.font_display | font_modify: 'weight', settings.heading_weight
  assign heading_bold = settings.font_display | font_modify: 'weight', '700'
  assign body_medium = settings.font_body | font_modify: 'weight', '500'
  assign body_semibold = settings.font_body | font_modify: 'weight', '600'
  assign body_bold = settings.font_body | font_modify: 'weight', '700'
  assign body_extra = settings.font_body | font_modify: 'weight', '800'
  assign scale = settings.heading_scale | divided_by: 100.0
-%}
<style>
  {{ settings.font_display | font_face: font_display: 'swap' }}
  {%- if heading_font %}{{ heading_font | font_face: font_display: 'swap' }}{% endif -%}
  {%- if heading_bold %}{{ heading_bold | font_face: font_display: 'swap' }}{% endif -%}
  {{ settings.font_body | font_face: font_display: 'swap' }}
  {%- if body_medium %}{{ body_medium | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_semibold %}{{ body_semibold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_bold %}{{ body_bold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if body_extra %}{{ body_extra | font_face: font_display: 'swap' }}{% endif -%}

  :root {
    --font-display: {{ settings.font_display.family }}, {{ settings.font_display.fallback_families }};
    --font-display-weight: {{ settings.heading_weight }};
    --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
    --font-body-weight: {{ settings.font_body.weight }};
    --heading-scale: {{ scale }};

    --c-brand: {{ settings.color_brand }};
    --c-brand-rgb: {{ settings.color_brand | color_extract: 'red' }} {{ settings.color_brand | color_extract: 'green' }} {{ settings.color_brand | color_extract: 'blue' }};
    --c-brand-deep: {{ settings.color_brand_deep }};
    --c-brand-soft: {{ settings.color_brand_soft }};
    --c-ink: {{ settings.color_ink }};
    --c-ink-rgb: {{ settings.color_ink | color_extract: 'red' }} {{ settings.color_ink | color_extract: 'green' }} {{ settings.color_ink | color_extract: 'blue' }};
    --c-paper: {{ settings.color_paper }};
    --c-mint: {{ settings.color_mint }};
    --c-footer: {{ settings.color_footer }};
    --c-night: {{ settings.color_night }};
    --c-heat: {{ settings.color_heat }};
    --c-ice: {{ settings.color_ice }};
    --c-sale: {{ settings.color_sale }};
    --logo-width: {{ settings.logo_width }}px;
    --card-ratio: {{ settings.card_image_ratio }};
  }
</style>
