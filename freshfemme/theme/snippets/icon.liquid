  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
  {%- when 'account' -%}
    <svg {{ attrs }}><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M4 8h16M4 16h10"/></svg>
  {%- when 'close' -%}
