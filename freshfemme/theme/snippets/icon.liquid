{%- comment -%}
  Ícones em linha (stroke = currentColor).
  Uso: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
{%- capture attrs -%}class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}
