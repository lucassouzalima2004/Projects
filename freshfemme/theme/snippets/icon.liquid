    <svg {{ attrs }}><path d="M14.5 21v-7.5H17l.5-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.5V4.3A19 19 0 0 0 15.3 4c-2.2 0-3.8 1.4-3.8 3.9v2.6H9v3h2.5V21"/></svg>
