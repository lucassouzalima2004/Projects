{%- comment -%}
  Card de produto.
  Uso: {% render 'product-card', product: product, index: forloop.index0, sizes: '(min-width: 990px) 25vw, 50vw' %}
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign title_parts = product.title | split: ' | '
  assign main_title = title_parts | first
  assign sub_title = ''
  if title_parts.size > 1
    assign sub_title = title_parts[1]
  endif
  assign t = product.title | downcase
  assign tone = 'brand'
  assign category = 'products.card.category_default' | t
  if t contains 'spray'
    assign category = 'products.card.category_spray' | t
    assign tone = 'ice'
  endif
  if t contains 'sérum' or t contains 'serum'
    assign category = 'products.card.category_serum' | t
    assign tone = 'brand'
  endif
  if t contains 'vivaage'
    assign category = 'products.card.category_supplement' | t
    assign tone = 'lilac'
    if t contains 'slim'
      assign tone = 'sage'
    endif
  endif
  if t contains 'sabonete'
    assign category = 'products.card.category_soap' | t
    assign tone = 'sand'
  endif
  if t contains 'presente'
    assign category = 'products.card.category_gift' | t
    assign tone = 'rose'
  endif
  assign promo = false
  if t contains 'leve 3'
    assign promo = 'products.card.badge_3for2' | t
  endif
  assign second = product.images[1]
  if settings.card_second_image == false
    assign second = nil
  endif
  assign image_alt = product.featured_image.alt | default: main_title
  assign sizes = sizes | default: '(min-width: 1200px) 300px, (min-width: 750px) 33vw, 50vw'
-%}
<article class="card card--{{ tone }}" {% if animate != false %}data-reveal style="--i: {{ index | default: 0 | modulo: 4 }}"{% endif %}>
  <a href="{{ product.url }}" class="card__media{% if second %} card__media--swap{% endif %}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag:
        class: 'card__img',
        loading: 'lazy',
        widths: '300, 450, 600, 750, 900',
        sizes: sizes,
        alt: image_alt
      }}
      {%- if second -%}
        {{ second | image_url: width: 900 | image_tag:
          class: 'card__img card__img--alt',
          loading: 'lazy',
          widths: '300, 450, 600, 750, 900',
          sizes: sizes,
          alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__img card__placeholder' }}
    {%- endif -%}
    <span class="card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        {%- assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge--sale">-{{ saving }}%</span>
      {%- endif -%}
      {%- if promo -%}<span class="badge badge--ink">{{ promo }}</span>{%- endif -%}
    </span>
  </a>

  {%- if settings.card_quick_add and product.available -%}
    <div class="card__quick">
      {%- if product.has_only_default_variant -%}
        <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" class="card__form" data-product-form>
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="card__add" data-add-button>
            <span class="card__add-label">{{ 'products.card.quick_add' | t }}</span>
            {% render 'icon', name: 'plus' %}
          </button>
        </form>
      {%- else -%}
        <a href="{{ product.url }}" class="card__add">
          <span class="card__add-label">{{ 'products.card.choose' | t }}</span>
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="card__info">
    <span class="card__category">{{ category }}</span>
    <h3 class="card__title">
      <a href="{{ product.url }}" class="card__link">{{ main_title }}</a>
    </h3>
    {%- if sub_title != blank -%}
      <p class="card__subtitle">{{ sub_title }}</p>
    {%- endif -%}
    {% render 'price', product: product %}
  </div>
</article>
