<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" {% if settings.animations %}data-animations{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'template-pages.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
