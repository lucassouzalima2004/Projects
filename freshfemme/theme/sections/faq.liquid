<section class="section faq">
  <div class="container faq__grid">
    <div class="faq__intro">
      {% render 'section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, align: 'left' %}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--outline" data-reveal>
          {% render 'icon', name: 'whatsapp' %}
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" data-accordion data-reveal style="--i: {{ forloop.index0 | modulo: 6 }}" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question }}</span>
            <span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="accordion__content" data-accordion-content>
            <div class="rte">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Perguntas frequentes",
  "class": "section-faq",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Chamada", "default": "Dúvidas" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Perguntas <em>frequentes</em>" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Não encontrou o que procurava? Fale com a gente.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Falar com a equipe" },
    { "type": "url", "id": "button_link", "label": "Link do botão" },
    { "type": "checkbox", "id": "schema", "label": "Marcar como FAQ para o Google", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta", "default": "Como usar o spray?" },
        { "type": "richtext", "id": "answer", "label": "Resposta", "default": "<p>Aplique um jato contínuo por todo o pescoço, como um colar, principalmente na nuca, no momento do fogacho.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [{ "type": "question" }]
    }
  ]
}
{% endschema %}
