<section class="section section--night video-feature" id="prova-real">
  <div class="video-feature__glow" aria-hidden="true"></div>
  <div class="container video-feature__grid">
    <div class="video-feature__copy">
      {% render 'section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, align: 'left' %}

      {%- assign stats = section.blocks | where: 'type', 'stat' -%}
      {%- if stats.size > 0 -%}
        <dl class="video-feature__stats">
          {%- for block in stats -%}
            <div class="video-feature__stat" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <dt><span data-count-to="{{ block.settings.number }}">{{ block.settings.number }}</span>{{ block.settings.suffix }}</dt>
              <dd>{{ block.settings.label }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.badge != blank -%}
        <p class="video-feature__badge" data-reveal>
          <span class="video-feature__badge-mark">{{ section.settings.badge_mark }}</span>
          <span>{{ section.settings.badge }}</span>
        </p>
      {%- endif -%}
    </div>

    <div class="video-feature__media" data-reveal="clip">
      <div class="video-frame" data-video="{{ section.settings.youtube_id }}">
        {%- if section.settings.poster != blank -%}
          {%- assign poster_alt = section.settings.heading | strip_html -%}
          {{ section.settings.poster | image_url: width: 1600 | image_tag: class: 'video-frame__poster', loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: poster_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'video-frame__poster placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.youtube_id != blank -%}
          <button type="button" class="video-frame__play" data-video-play aria-label="{{ 'sections.video.play' | t }}">
            <span class="video-frame__play-ring"></span>
            {% render 'icon', name: 'play' %}
          </button>
        {%- endif -%}
        <span class="video-frame__label">{{ section.settings.video_label }}</span>
      </div>
    </div>
  </div>

  {%- assign proofs = section.blocks | where: 'type', 'proof' -%}
  {%- if proofs.size > 0 -%}
    <div class="container proofs" id="provas">
      <div class="proofs__head" data-reveal>
        <div>
          {%- if section.settings.proofs_heading != blank -%}
            <h3 class="proofs__title">{{ section.settings.proofs_heading }}</h3>
          {%- endif -%}
          {%- if section.settings.proofs_text != blank -%}
            <p class="proofs__text">{{ section.settings.proofs_text }}</p>
          {%- endif -%}
        </div>
        <div class="proofs__nav">
          <button type="button" class="proofs__arrow" data-proofs-prev aria-label="{{ 'sections.video.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="proofs__arrow" data-proofs-next aria-label="{{ 'sections.video.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      </div>
      <ul class="proofs__list proofs__list--{{ section.settings.proofs_format }}" role="list" data-proofs>
        {%- for block in proofs -%}
          {%- liquid
            assign kind = ''
            assign src = ''
            if block.settings.video != blank
              assign kind = 'file'
            elsif block.settings.video_url != blank
              assign kind = block.settings.video_url.type
              assign src = block.settings.video_url.id
            elsif block.settings.instagram != blank
              assign kind = 'instagram'
              assign src = block.settings.instagram
            endif
          -%}
          {%- if kind != '' -%}
            <li class="proofs__item" data-reveal style="--i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="proof"
                data-proof
                data-kind="{{ kind }}"
                data-src="{{ src | escape }}"
                aria-label="{{ 'sections.video.watch' | t: title: block.settings.title | escape }}"
              >
                <span class="proof__media">
                  {%- if block.settings.poster != blank -%}
                    {{ block.settings.poster | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, 78vw', alt: '' }}
                  {%- elsif kind == 'file' and block.settings.video.preview_image != blank -%}
                    {{ block.settings.video.preview_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, 78vw', alt: '' }}
                  {%- elsif kind == 'youtube' -%}
                    {%- comment -%} capa do próprio YouTube; para servir pela Shopify, envie uma imagem em "Capa" {%- endcomment -%}
                    {% # theme-check-disable RemoteAsset %}
                    <img src="https://i.ytimg.com/vi/{{ src }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
                    {% # theme-check-enable RemoteAsset %}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  <span class="proof__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
                </span>
                <span class="proof__body">
                  <span class="proof__title">{{ block.settings.title }}</span>
                  {%- if block.settings.caption != blank -%}
                    <span class="proof__caption">{{ block.settings.caption }}</span>
                  {%- endif -%}
                </span>
              </button>
              {%- if kind == 'file' -%}
                <template data-proof-video>{{ block.settings.video | video_tag: controls: true, autoplay: true, playsinline: true }}</template>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <dialog class="video-modal" data-video-modal aria-label="{{ 'sections.video.player' | t }}">
      <div class="video-modal__frame" data-video-modal-frame></div>
      <button type="button" class="video-modal__close" data-video-modal-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </dialog>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Vídeo e provas reais",
  "class": "section-video",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Chamada" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "O spray da menopausa que <em>encantou os Sharks</em>" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Premiado duas vezes a nível nacional e apresentado no Shark Tank Brasil. Veja o FreshFemme em ação.</p>" },
    { "type": "text", "id": "youtube_id", "label": "ID do vídeo no YouTube", "info": "O código depois de watch?v= ou youtu.be/", "default": "57_30YCA27Y" },
    { "type": "image_picker", "id": "poster", "label": "Capa do vídeo" },
    { "type": "text", "id": "video_label", "label": "Legenda sobre o vídeo", "default": "Shark Tank Brasil · Temporada 10" },
    { "type": "text", "id": "badge_mark", "label": "Selo (marca curta)" },
    { "type": "text", "id": "badge", "label": "Selo (texto)" },
    {
      "type": "header",
      "content": "Provas reais (carrossel de vídeos)"
    },
    {
      "type": "paragraph",
      "content": "Adicione blocos de Vídeo de prova: depoimentos de clientes e médicos, explicações da Dra. Mariá, o vídeo da câmera térmica. O botão Ver a prova real da capa leva até aqui."
    },
    { "type": "text", "id": "proofs_heading", "label": "Título do carrossel", "default": "Provas reais" },
    { "type": "text", "id": "proofs_text", "label": "Texto do carrossel" },
    {
      "type": "select",
      "id": "proofs_format",
      "label": "Formato dos vídeos",
      "options": [
        { "value": "horizontal", "label": "Horizontal (YouTube)" },
        { "value": "vertical", "label": "Vertical (Instagram, Reels, TikTok)" }
      ],
      "default": "horizontal"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Número",
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "2" },
        { "type": "text", "id": "suffix", "label": "Sufixo", "default": "x" },
        { "type": "text", "id": "label", "label": "Legenda", "default": "premiado a nível nacional" }
      ]
    },
    {
      "type": "proof",
      "name": "Vídeo de prova",
      "settings": [
        { "type": "video_url", "id": "video_url", "label": "Vídeo do YouTube ou Vimeo", "accept": ["youtube", "vimeo"] },
        { "type": "video", "id": "video", "label": "Ou um vídeo enviado para a Shopify", "info": "Bom para vídeos baixados do Instagram: tocam aqui mesmo, sem sair do site." },
        { "type": "url", "id": "instagram", "label": "Ou o link de um post ou reel do Instagram" },
        { "type": "image_picker", "id": "poster", "label": "Capa (opcional)", "info": "Vídeos do YouTube já usam a capa do próprio vídeo." },
        { "type": "text", "id": "title", "label": "Título", "default": "Depoimentos de quem usa FreshFemme" },
        { "type": "text", "id": "caption", "label": "Quem fala", "default": "Clientes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vídeo em destaque",
      "blocks": [{ "type": "stat" }]
    }
  ]
}
{% endschema %}
