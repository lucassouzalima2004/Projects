{{ 'template-collection.css' | asset_url | stylesheet_tag }}
<section class="page-hero">
  <div class="container page-hero__inner">
    <p class="eyebrow" data-reveal>{{ shop.name }}</p>
    <h1 class="h1" data-reveal="words">{{ section.settings.heading }}</h1>
  </div>
</section>
<section class="section section--flush-top">
  <div class="container">
    <ul class="collections-grid" role="list">
      {%- for collection in collections -%}
        {%- if collection.handle != 'frontpage' and collection.products_count > 0 -%}
          {%- assign image = collection.image | default: collection.featured_image -%}
          <li data-reveal="scale" style="--i: {{ forloop.index0 | modulo: 3 }}">
            <a href="{{ collection.url }}" class="bento__link" data-tilt="4">
              <span class="bento__media">
                {%- if image -%}
                  {{ image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: collection.title }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="bento__shade" aria-hidden="true"></span>
              <span class="bento__body">
                <span class="bento__title">{{ collection.title }}</span>
                <span class="bento__count">{{ 'sections.categories.count' | t: count: collection.products_count }}</span>
              </span>
              <span class="bento__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-up-right' %}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Lista de coleções",
  "class": "section-list-collections",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Todas as <em>categorias</em>" }
  ]
}
{% endschema %}
