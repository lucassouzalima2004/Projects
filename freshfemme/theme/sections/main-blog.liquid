{{ 'template-pages.css' | asset_url | stylesheet_tag }}
<section class="page-hero">
  <div class="container page-hero__inner">
    <p class="eyebrow" data-reveal>{{ 'blogs.eyebrow' | t }}</p>
    <h1 class="h1" data-reveal="words">{{ blog.title }}</h1>
  </div>
</section>
{%- paginate blog.articles by 9 -%}
  <section class="section section--flush-top">
    <div class="container">
      <div class="articles">
        {%- for article in blog.articles -%}
          <article class="article-card{% if forloop.first and paginate.current_page == 1 %} article-card--featured{% endif %}" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">
            <a href="{{ article.url }}" class="article-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="article-card__body">
              <p class="article-card__date">{{ article.published_at | date: format: 'date' }}</p>
              <h2 class="h3 article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
              <a href="{{ article.url }}" class="link-arrow">{{ 'blogs.read' | t }} {% render 'icon', name: 'arrow' %}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
