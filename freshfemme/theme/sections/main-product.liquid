{{ 'template-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign title_parts = product.title | split: ' | '
  assign main_title = title_parts | first
  assign sub_title = ''
  if title_parts.size > 1
    assign sub_title = title_parts[1]
  endif
  assign media_count = product.media.size
-%}

<section class="product section section--flush-top" data-product id="Product-{{ section.id }}">
  <div class="container container--wide product__grid">
    {%- comment -%} Galeria {%- endcomment -%}
    <div class="product__gallery{% if media_count < 2 %} product__gallery--single{% endif %}">
      {%- if media_count > 1 -%}
        <div class="product__thumbs" role="list">
          {%- for media in product.media -%}
            <button type="button" class="product__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="{{ 'products.product.media' | t: n: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="product__thumb-play">{% render 'icon', name: 'play' %}</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="product__stage">
        <div class="product__track" data-gallery-track>
          {%- for media in product.media -%}
            {%- assign media_alt = media.alt | default: main_title -%}
            <figure class="product__slide" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" {% if media.media_type == 'image' %}data-zoom{% endif %}>
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}
                    {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media_alt }}
                  {%- else -%}
                    {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media_alt }}
                  {%- endif -%}
                {%- when 'external_video' -%}
                  <div class="product__video">{{ media | external_video_tag: loading: 'lazy' }}</div>
                {%- when 'video' -%}
                  <div class="product__video">{{ media | video_tag: controls: true, muted: true, playsinline: true, loop: true, image_size: '1200x' }}</div>
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </figure>
          {%- else -%}
            <figure class="product__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</figure>
          {%- endfor -%}
        </div>
        {%- if media_count > 1 -%}
          <button type="button" class="product__arrow product__arrow--prev" data-gallery-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</button>
          <button type="button" class="product__arrow product__arrow--next" data-gallery-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
          <div class="product__dots">
            {%- for media in product.media -%}
              <button type="button" class="product__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="{{ 'products.product.media' | t: n: forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}
          {%- assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          <span class="product__sticker">-{{ saving }}%</span>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Informações {%- endcomment -%}
    <div class="product__info">
      <div class="product__info-inner">
        <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
          <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
          <span aria-hidden="true">/</span>
          {%- if collection -%}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
            <span aria-hidden="true">/</span>
          {%- endif -%}
          <span>{{ main_title | truncate: 40 }}</span>
        </nav>

        <h1 class="product__title">{{ main_title }}</h1>
        {%- if sub_title != blank -%}
          <p class="product__subtitle">{{ sub_title }}</p>
        {%- endif -%}

        <div class="product__price" data-main-price>
          {% render 'price', product: product, variant: current_variant, price_size: 'lg', show_badge: true %}
        </div>

        {%- form 'product', product, class: 'product__form', data-main-form: '', data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="product__block product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

              {%- when 'benefits' -%}
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                <ul class="product__benefits" role="list" {{ block.shopify_attributes }}>
                  {%- for line in lines -%}
                    {%- assign item = line | strip -%}
                    {%- if item != blank -%}
                      <li>{% render 'icon', name: 'check' %}<span>{{ item }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="product__block product__variants" {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      <fieldset class="option" data-option-index="{{ forloop.index0 }}">
                        <legend class="option__legend">{{ option.name }}: <span data-option-value>{{ option.selected_value }}</span></legend>
                        <div class="option__values">
                          {%- for value in option.values -%}
                            <label class="option__pill">
                              <input type="radio" form="Options-{{ section.id }}" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                              <span>{{ value }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

              {%- when 'kit_picker' -%}
                {%- if block.settings.kits.first -%}
                  <fieldset class="product__block kits" {{ block.shopify_attributes }}>
                    <legend class="kits__legend">{{ block.settings.heading }}</legend>
                    {%- assign kit_index = 0 -%}
                    {%- if block.settings.include_current -%}
                      {%- assign kit_index = 1 -%}
                      <label class="kit">
                        <input type="radio" form="Kits-{{ section.id }}" name="kit-{{ section.id }}" value="{{ current_variant.id }}" data-kit-option data-price="{{ current_variant.price }}" data-compare="{{ current_variant.compare_at_price | default: 0 }}" data-available="{{ current_variant.available }}" checked>
                        <span class="kit__radio" aria-hidden="true"></span>
                        <span class="kit__label">
                          <strong>{{ 'products.kits.single' | t }}</strong>
                          <small>{{ current_variant.price | money }}</small>
                        </span>
                        <span class="kit__price">{{ current_variant.price | money }}</span>
                      </label>
                    {%- endif -%}
                    {%- for kit in block.settings.kits -%}
                      {%- liquid
                        assign kit_variant = kit.selected_or_first_available_variant
                        assign words = kit.title | split: ' '
                        assign units = 1
                        assign kit_label = kit.title | split: ' | ' | first | truncate: 34
                        if words[0] == 'Kit'
                          assign maybe = words[1] | plus: 0
                          if maybe > 1
                            assign units = maybe
                            assign kit_label = 'products.kits.units' | t: n: units
                          endif
                        endif
                        assign per_unit = kit_variant.price | divided_by: units
                        assign per_unit_money = per_unit | money
                        assign position = forloop.index | plus: kit_index
                        assign kit_saving = 0
                        if kit_variant.compare_at_price > kit_variant.price
                          assign kit_saving = kit_variant.compare_at_price | minus: kit_variant.price | times: 100.0 | divided_by: kit_variant.compare_at_price | round
                        endif
                      -%}
                      <label class="kit{% if position == block.settings.highlight %} kit--highlight{% endif %}">
                        <input type="radio" form="Kits-{{ section.id }}" name="kit-{{ section.id }}" value="{{ kit_variant.id }}" data-kit-option data-price="{{ kit_variant.price }}" data-compare="{{ kit_variant.compare_at_price | default: 0 }}" data-available="{{ kit_variant.available }}" {% if kit.id == product.id and block.settings.include_current == false %}checked{% endif %}>
                        <span class="kit__radio" aria-hidden="true"></span>
                        <span class="kit__label">
                          <strong>{{ kit_label }}</strong>
                          {%- if units > 1 -%}<small>{{ 'products.kits.each' | t: amount: per_unit_money }}</small>{%- endif -%}
                        </span>
                        <span class="kit__price">
                          {%- if kit_saving > 0 -%}<em>-{{ kit_saving }}%</em>{%- endif -%}
                          {{ kit_variant.price | money }}
                        </span>
                        {%- if position == block.settings.highlight and block.settings.highlight_label != blank -%}
                          <span class="kit__flag">{{ block.settings.highlight_label }}</span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- endif -%}

              {%- when 'buy_buttons' -%}
                <div class="product__block product__buy" {{ block.shopify_attributes }}>
                  <div class="product__buy-row">
                    {%- if block.settings.show_quantity -%}
                      <div class="qty" data-qty>
                        <button type="button" data-qty-minus aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                        <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
                        <button type="button" data-qty-plus aria-label="{{ 'cart.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                      </div>
                    {%- endif -%}
                    <button type="submit" name="add" class="btn btn--brand btn--lg product__add" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                      <span data-add-label>
                        {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                      </span>
                      {% render 'icon', name: 'cart' %}
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product__dynamic">{{ form | payment_button }}</div>
                  {%- endif -%}
                </div>

              {%- when 'shipping' -%}
                {%- liquid
                  assign threshold = settings.free_shipping_threshold | times: 100
                  assign missing = threshold | minus: current_variant.price
                  assign missing_money = missing | money
                -%}
                {%- if threshold > 0 -%}
                  <p class="product__block product__ship" {{ block.shopify_attributes }}>
                    {% render 'icon', name: 'truck' %}
                    {%- if missing > 0 -%}
                      <span>{{ 'products.product.free_shipping_missing_html' | t: amount: missing_money }}</span>
                    {%- else -%}
                      <span>{{ 'products.product.free_shipping_ok_html' | t }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}

              {%- when 'trust' -%}
                <ul class="product__block product__trust" role="list" {{ block.shopify_attributes }}>
                  <li>{% render 'icon', name: 'lock' %}<span>{{ block.settings.item_1 }}</span></li>
                  <li>{% render 'icon', name: 'shield' %}<span>{{ block.settings.item_2 }}</span></li>
                  <li>{% render 'icon', name: 'leaf' %}<span>{{ block.settings.item_3 }}</span></li>
                </ul>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <details class="accordion product__accordion" data-accordion {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary class="accordion__summary"><span>{{ block.settings.title }}</span><span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span></summary>
                    <div class="accordion__content" data-accordion-content><div class="rte">{{ product.description }}</div></div>
                  </details>
                {%- endif -%}

              {%- when 'collapsible' -%}
                <details class="accordion product__accordion" data-accordion {{ block.shopify_attributes }}>
                  <summary class="accordion__summary"><span>{{ block.settings.title }}</span><span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span></summary>
                  <div class="accordion__content" data-accordion-content>
                    <div class="rte">
                      {{ block.settings.content }}
                      {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                    </div>
                  </div>
                </details>
            {%- endcase -%}
          {%- endfor -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  {%- comment -%} Barra fixa de compra {%- endcomment -%}
  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    <div class="container container--wide sticky-atc__inner">
      <div class="sticky-atc__product">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 52, height: 52 }}
        {%- endif -%}
        <div>
          <p class="sticky-atc__title">{{ main_title }}</p>
          <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
        </div>
      </div>
      <button type="button" class="btn btn--brand" data-sticky-add tabindex="-1">
        {{ 'products.product.add_to_cart' | t }} {% render 'icon', name: 'cart' %}
      </button>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
      "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Produto",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "text", "name": "Texto", "settings": [{ "type": "richtext", "id": "text", "label": "Texto" }] },
    {
      "type": "benefits",
      "name": "Benefícios",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "items", "label": "Itens (um por linha)", "default": "Alívio imediato das ondas de calor\nNatural, vegano e aprovado pela Anvisa\nSem contraindicações e sem receita" }
      ]
    },
    { "type": "variant_picker", "name": "Variações", "limit": 1, "settings": [] },
    {
      "type": "kit_picker",
      "name": "Escolha de kits",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Mostra opções como 1 unidade, Kit 2, Kit 3… Cada opção adiciona o produto do kit ao carrinho." },
        { "type": "text", "id": "heading", "label": "Título", "default": "Escolha seu kit e economize" },
        { "type": "product_list", "id": "kits", "label": "Kits", "limit": 5 },
        { "type": "checkbox", "id": "include_current", "label": "Incluir \"1 unidade\" (este produto) como primeira opção", "default": true },
        { "type": "range", "id": "highlight", "label": "Destacar a opção nº", "min": 1, "max": 6, "step": 1, "default": 3 },
        { "type": "text", "id": "highlight_label", "label": "Texto do destaque", "default": "Mais escolhido" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Botões de compra",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Mostrar quantidade", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar \"Comprar agora\"", "default": true }
      ]
    },
    { "type": "shipping", "name": "Aviso de frete grátis", "limit": 1, "settings": [] },
    {
      "type": "trust",
      "name": "Selos de confiança",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "Selo 1", "default": "Compra 100% segura" },
        { "type": "text", "id": "item_2", "label": "Selo 2", "default": "Aprovado pela Anvisa" },
        { "type": "text", "id": "item_3", "label": "Selo 3", "default": "Vegano e cruelty-free" }
      ]
    },
    {
      "type": "description",
      "name": "Descrição",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Descrição" },
        { "type": "checkbox", "id": "open", "label": "Aberta por padrão", "default": false }
      ]
    },
    {
      "type": "collapsible",
      "name": "Aba recolhível",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Modo de usar" },
        { "type": "richtext", "id": "content", "label": "Conteúdo" },
        { "type": "page", "id": "page", "label": "Ou conteúdo de uma página" }
      ]
    }
  ]
}
{% endschema %}
