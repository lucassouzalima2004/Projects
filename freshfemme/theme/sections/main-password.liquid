<section class="password-page">
  <div class="password-page__inner">
    {%- if settings.logo_inverse != blank -%}
      {{ settings.logo_inverse | image_url: width: 480 | image_tag: class: 'password-page__logo', alt: shop.name }}
    {%- else -%}
      <p class="header__logo-text">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="display">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="PasswordEmail" class="visually-hidden">{{ 'sections.newsletter.email' | t }}</label>
          <input id="PasswordEmail" class="newsletter__input" type="email" name="contact[email]" placeholder="{{ 'sections.newsletter.email' | t }}" required>
          <button type="submit" class="btn btn--brand">{{ 'sections.newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password-page__login">
      <summary>{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter__field' -%}
        <input class="newsletter__input" type="password" name="password" placeholder="{{ 'customer.password' | t }}" autocomplete="current-password">
        <button type="submit" class="btn">{{ 'general.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{
  "name": "Senha",
  "class": "section-main-password",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Algo <em>fresco</em> vem aí." }
  ]
}
{% endschema %}
