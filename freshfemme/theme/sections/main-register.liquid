{{ 'template-pages.css' | asset_url | stylesheet_tag }}
<section class="section account-auth">
  <div class="container">
    <div class="auth-card" data-reveal="scale">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', class: 'auth-card__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="contact__row">
          <label class="field"><span>{{ 'customer.first_name' | t }}</span><input class="input" type="text" name="customer[first_name]" autocomplete="given-name"></label>
          <label class="field"><span>{{ 'customer.last_name' | t }}</span><input class="input" type="text" name="customer[last_name]" autocomplete="family-name"></label>
        </div>
        <label class="field"><span>{{ 'customer.email' | t }}</span><input class="input" type="email" name="customer[email]" autocomplete="email" required></label>
        <label class="field"><span>{{ 'customer.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
        <button type="submit" class="btn btn--brand btn--lg btn--block">{{ 'customer.register.submit' | t }}</button>
        <a href="{{ routes.account_login_url }}" class="auth-card__link">{{ 'customer.register.login' | t }}</a>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Cadastro", "class": "section-main-register", "settings": [] }
{% endschema %}
