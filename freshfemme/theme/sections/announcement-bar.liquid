{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <div class="container announcement__inner"{% if section.blocks.size > 1 %} data-rotator data-interval="{{ section.settings.interval }}"{% endif %}>
      {%- for block in section.blocks -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anúncios",
  "class": "section-announcement",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "label": "Troca de mensagem a cada (segundos)",
      "info": "Só vale quando há mais de uma mensagem.",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "<strong>Frete grátis</strong> para todo o Brasil em compras acima de R$ 150" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncios",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
