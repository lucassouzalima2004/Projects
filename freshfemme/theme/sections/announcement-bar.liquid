{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}" style="--marquee-speed: {{ section.settings.speed }}s">
    <div class="announcement__track">
      {%- for copy in (1..2) -%}
        <div class="announcement__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          {%- for repeat in (1..3) -%}
            {%- for block in section.blocks -%}
              <span class="announcement__item" {% if copy == 1 and repeat == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}"{% if copy == 2 or repeat > 1 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anúncios",
  "class": "section-announcement",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidade (segundos por volta)",
      "min": 20,
      "max": 90,
      "step": 2,
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "<strong>Frete grátis</strong> acima de R$ 150" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncios",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
