{{ 'template-pages.css' | asset_url | stylesheet_tag }}
<section class="page-hero">
  <div class="container page-hero__inner">
    <h1 class="h1" data-reveal="words">{{ page.title }}</h1>
  </div>
</section>
<section class="section section--flush-top">
  <div class="container container--narrow">
    <div class="rte page-content" data-reveal>{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Página",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
