# Cabeçalhos do Cloudflare (este arquivo não aparece no site).

# Enquanto o site estiver só no endereço .workers.dev (prévia), o Google não indexa:
# o site atual do Carlos (puntopizzaverona.it) continua sendo o que aparece nas buscas.
# Quando o domínio dele for ligado a este site, ele fica indexável normalmente.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# A fonte nunca muda de conteúdo: o navegador pode guardar por um ano
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos e ícones: uma semana (se trocar um arquivo, use um nome novo para atualizar na hora)
/assets/img/*
  Cache-Control: public, max-age=604800
