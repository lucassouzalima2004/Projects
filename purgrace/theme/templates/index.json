      "type": "steps",
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "title": "Last on, first off",
            "text": "<p>Put your jewellery on about 10 minutes after perfume, creams and sunscreen, and take it off before the gym, a swim or bed.</p>"
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "title": "Keep it dry",
            "text": "<p>Take it off for the beach, the pool and hot showers, and keep it away from detergents and alcohol gel.</p>"
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "title": "Wipe and store apart",
            "text": "<p>Wipe it with a soft, dry cloth and keep each piece in its own pouch, away from sun and heat.</p>"
          }
        }
