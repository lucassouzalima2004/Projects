{%- layout none -%}
{%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
{%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros: gift_card.currency -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value, shop: shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="gift-card">
      <div class="gift-card__inner">
        {% render 'logo' %}
        <div class="gift-card__card">
          {% render 'butterfly', class: 'gift-card__mark' %}
          <p class="eyebrow">{{ 'gift_cards.issued.subtext' | t }}</p>
          <p class="gift-card__value">{{ formatted_balance }}</p>
          {%- if gift_card.balance != gift_card.initial_value -%}
            <p class="gift-card__initial">{{ 'gift_cards.issued.initial_value' | t: value: formatted_initial_value }}</p>
          {%- endif -%}
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <p class="badge badge--soldout">{{ 'gift_cards.issued.expired' | t }}</p>
          {%- endif -%}
          {%- if gift_card.expires_on -%}
            {%- assign expires_on = gift_card.expires_on | date: '%d %B %Y' -%}
            <p class="gift-card__expires">{{ 'gift_cards.issued.expires_on' | t: expires_on: expires_on }}</p>
          {%- endif -%}
          <div class="gift-card__code">
            <input type="text" class="field__input" id="GiftCardCode" value="{{ gift_card.code }}" readonly aria-label="{{ 'gift_cards.issued.code' | t }}">
            <copy-button class="btn btn--ghost btn--sm" data-target="GiftCardCode" role="button" tabindex="0">{{ 'gift_cards.issued.copy' | t }}</copy-button>
          </div>
        </div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
          </a>
        {%- endif -%}
        <div class="gift-card__actions">
          <a href="{{ shop.url }}" class="btn btn--primary">{{ 'gift_cards.issued.shop_link' | t }}</a>
          <button type="button" class="link-btn" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
        </div>
      </div>
    </main>
  </body>
</html>
