<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_dark }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="goldStroke" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#9C7536"/>
          <stop offset=".28" stop-color="#E7CB86"/>
          <stop offset=".52" stop-color="#B98F43"/>
          <stop offset=".78" stop-color="#F2E1B0"/>
          <stop offset="1" stop-color="#A27A38"/>
        </linearGradient>
        <radialGradient id="goldFill" cx=".35" cy=".3" r=".85">
          <stop offset="0" stop-color="#F8E9BF"/>
          <stop offset=".42" stop-color="#DDB86A"/>
          <stop offset=".78" stop-color="#B2893B"/>
          <stop offset="1" stop-color="#8E6A2C"/>
        </radialGradient>
        <radialGradient id="jewelShadow">
          <stop offset="0" stop-color="#000" stop-opacity=".3"/>
          <stop offset="1" stop-color="#000" stop-opacity="0"/>
        </radialGradient>
      </defs>
    </svg>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
