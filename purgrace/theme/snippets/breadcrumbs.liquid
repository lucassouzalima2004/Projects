{%- comment -%}
  Visible breadcrumbs plus the matching BreadcrumbList structured data for Google.
{%- endcomment -%}
{%- liquid
  assign mid_title = ''
  assign mid_url = ''
  assign current_title = ''

  case request.page_type
    when 'product'
      if collection
        assign mid_title = collection.title
        assign mid_url = collection.url
      endif
      assign current_title = product.title
    when 'collection'
      assign current_title = collection.title
    when 'list-collections'
      assign current_title = 'collections.list.title' | t
    when 'article'
      assign mid_title = blog.title
      assign mid_url = blog.url
      assign current_title = article.title
    when 'blog'
      if current_tags
        assign mid_title = blog.title
        assign mid_url = blog.url
        assign current_title = current_tags | join: ', '
      else
        assign current_title = blog.title
      endif
    when 'page'
      assign current_title = page.title
    when 'search'
      assign current_title = 'search.title' | t
  endcase
-%}
{%- if current_title != blank -%}
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
      {%- if mid_title != blank -%}
        <li><a href="{{ mid_url }}">{{ mid_title | escape }}</a></li>
      {%- endif -%}
      <li>
        <span aria-current="page">
          {%- if request.page_type == 'product' -%}
            {% render 'product-title', title: current_title %}
          {%- else -%}
            {{ current_title | escape }}
          {%- endif -%}
        </span>
      </li>
    </ol>
  </nav>
  {%- liquid
    assign ld_title = current_title
    if request.page_type == 'product'
      capture ld_title
        render 'product-title', title: product.title, raw: true
      endcapture
      assign ld_title = ld_title | strip
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
        {%- if mid_title != blank %}
        { "@type": "ListItem", "position": 2, "name": {{ mid_title | json }}, "item": {{ request.origin | append: mid_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ ld_title | json }} }
        {%- else %}
        { "@type": "ListItem", "position": 2, "name": {{ ld_title | json }} }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}
