{%- doc -%}
  Variant data read by the product scripts (variant picker, price, add to cart button).
  Prices are rendered here so the page never has to format money in JavaScript.

  @param {object} product - Product
{%- enddoc -%}
<script type="application/json" data-product-json>
  {
    "id": {{ product.id }},
    "url": {{ product.url | json }},
    "strings": {
      "add": {{ 'products.product.add_to_cart' | t | json }},
      "soldOut": {{ 'products.product.sold_out' | t | json }},
      "unavailable": {{ 'products.product.unavailable' | t | json }}
    },
    "variants": [
      {%- for v in product.variants -%}
        {%- capture v_price -%}{% render 'price', product: product, variant: v %}{%- endcapture -%}
        {"id":{{ v.id }},"title":{{ v.title | json }},"options":{{ v.options | json }},"available":{{ v.available | json }},"media":{{ v.featured_media.id | default: 0 }},"price":{{ v.price | money | strip_html | json }},"priceHtml":{{ v_price | strip_newlines | json }}}
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    ]
  }
</script>
