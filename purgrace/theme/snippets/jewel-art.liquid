{%- doc -%}
  Gold jewellery illustration that fills product, collection and editorial spots until real
  photos are chosen. The gold gradients live in layout/theme.liquid.

  @param {string} [kind] - 'pendant' (default), 'hoops', 'ring', 'cross' or 'chain'
  @param {string} [class] - Extra classes
{%- enddoc -%}
<svg class="jewel-art{% if class %} {{ class }}{% endif %}" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  {%- case kind -%}
    {%- when 'hoops' -%}
      <ellipse cx="200" cy="352" rx="120" ry="10" fill="url(#jewelShadow)"/>
      <g class="jewel-art__piece">
        <circle cx="160" cy="210" r="78" fill="none" stroke="url(#goldStroke)" stroke-width="15"/>
        <circle cx="160" cy="210" r="78" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="2.5" stroke-dasharray="60 430" stroke-dashoffset="-40"/>
        <circle cx="258" cy="236" r="62" fill="none" stroke="url(#goldStroke)" stroke-width="12"/>
        <circle cx="258" cy="236" r="62" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2" stroke-dasharray="44 360" stroke-dashoffset="-30"/>
        <rect x="155" y="124" width="10" height="20" rx="5" fill="url(#goldFill)"/>
        <rect x="253" y="168" width="10" height="18" rx="5" fill="url(#goldFill)"/>
      </g>
    {%- when 'ring' -%}
      <ellipse cx="200" cy="330" rx="110" ry="12" fill="url(#jewelShadow)"/>
      <g class="jewel-art__piece">
        <ellipse cx="200" cy="238" rx="96" ry="84" fill="none" stroke="url(#goldStroke)" stroke-width="16"/>
        <ellipse cx="200" cy="238" rx="96" ry="84" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2.5" stroke-dasharray="70 520" stroke-dashoffset="-260"/>
        <path d="M200 116l26 26-26 30-26-30z" fill="#fff" stroke="url(#goldStroke)" stroke-width="5" stroke-linejoin="round"/>
        <path d="M174 142h52M200 116l-9 26 9 30 9-30z" fill="none" stroke="#e7dccf" stroke-width="2"/>
        <circle cx="214" cy="132" r="3" fill="#fff"/>
      </g>
    {%- when 'cross' -%}
      <path d="M78 40C120 150 170 196 200 204 230 196 280 150 322 40" fill="none" stroke="url(#goldStroke)" stroke-width="3" stroke-dasharray="7 5" stroke-linecap="round"/>
      <ellipse cx="200" cy="372" rx="70" ry="8" fill="url(#jewelShadow)"/>
      <g class="jewel-art__piece">
        <circle cx="200" cy="212" r="10" fill="none" stroke="url(#goldStroke)" stroke-width="5"/>
        <path d="M188 222h24v40h34v24h-34v66h-24v-66h-34v-24h34z" fill="url(#goldFill)" stroke="#9c7536" stroke-opacity=".35" stroke-width="1.5"/>
        <path d="M193 230v118" stroke="#fff" stroke-opacity=".5" stroke-width="3" stroke-linecap="round"/>
      </g>
    {%- when 'chain' -%}
      <ellipse cx="200" cy="340" rx="130" ry="10" fill="url(#jewelShadow)"/>
      <g class="jewel-art__piece" fill="none" stroke="url(#goldStroke)" stroke-width="7">
        {%- for i in (0..8) -%}
          {%- assign cx = i | times: 34 | plus: 64 -%}
          {%- assign tilt = i | modulo: 2 | times: 50 | minus: 25 -%}
          <ellipse cx="{{ cx }}" cy="210" rx="22" ry="13" transform="rotate({{ tilt }} {{ cx }} 210)"/>
        {%- endfor -%}
      </g>
    {%- else -%}
      <path d="M70 30C114 160 168 214 200 222 232 214 286 160 330 30" fill="none" stroke="url(#goldStroke)" stroke-width="3" stroke-dasharray="7 5" stroke-linecap="round"/>
      <ellipse cx="200" cy="364" rx="90" ry="9" fill="url(#jewelShadow)"/>
      <g class="jewel-art__piece">
        <rect x="190" y="212" width="20" height="30" rx="10" fill="none" stroke="url(#goldStroke)" stroke-width="6"/>
        <circle cx="200" cy="292" r="56" fill="url(#goldFill)"/>
        <circle cx="200" cy="292" r="46" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width="2"/>
        <circle cx="200" cy="292" r="56" fill="none" stroke="#9c7536" stroke-opacity=".35" stroke-width="1.5"/>
        <g transform="translate(176 274) scale(1)" fill="none" stroke="#9c7536" stroke-opacity=".7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M23.2 16.6C19.4 7.6 10.6 2.4 5.6 3.6 1.4 4.7 2.2 11.6 7.8 15.6c3.4 2.4 8.6 3.6 13.6 3.4M21.4 19.2c-6.4.2-11.6 4.2-11.2 9 .3 3.6 4.4 5 7.4 2.8 2.9-2.1 4.1-6.4 4.4-10.4M24.8 16.6C28.6 7.6 37.4 2.4 42.4 3.6c4.2 1.1 3.4 8-2.2 12-3.4 2.4-8.6 3.6-13.6 3.4M26.6 19.2c6.4.2 11.6 4.2 11.2 9-.3 3.6-4.4 5-7.4 2.8-2.9-2.1-4.1-6.4-4.4-10.4"/>
        </g>
        <path d="M166 262c8-12 22-20 36-20" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="5" stroke-linecap="round"/>
      </g>
  {%- endcase -%}
</svg>
