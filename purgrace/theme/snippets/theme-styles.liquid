{%- comment -%}
  Fonts and colours from Theme settings, as CSS custom properties used by base.css.
{%- endcomment -%}
{%- liquid
  assign heading_font = settings.type_heading_font
  assign heading_italic = heading_font | font_modify: 'style', 'italic'
  assign heading_bold = heading_font | font_modify: 'weight', '600'
  assign heading_bold_italic = heading_bold | font_modify: 'style', 'italic'

  assign body_font = settings.type_body_font
  assign body_italic = body_font | font_modify: 'style', 'italic'
  assign body_medium = body_font | font_modify: 'weight', '500'
  assign body_semibold = body_font | font_modify: 'weight', '600'
  assign body_bold = body_font | font_modify: 'weight', '700'

  assign scale = settings.heading_scale | divided_by: 100.0
-%}

{%- unless body_font.system? -%}
  {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- endunless -%}
{%- unless heading_font.system? -%}
  {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- endunless -%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_italic | font_face: font_display: 'swap' }}
  {{ heading_bold | font_face: font_display: 'swap' }}
  {{ heading_bold_italic | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_italic | font_face: font_display: 'swap' }}
  {{ body_medium | font_face: font_display: 'swap' }}
  {{ body_semibold | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}

  :root {
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --heading-scale: {{ scale }};

    --color-bg: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-text: {{ settings.color_text }};
    --color-muted: {{ settings.color_muted }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-deep: {{ settings.color_accent_deep }};
    --color-rose: {{ settings.color_rose }};
    --color-blush: {{ settings.color_blush }};
    --color-gold: {{ settings.color_gold }};
    --color-dark: {{ settings.color_dark }};

    --page-width: {{ settings.page_width }}px;
    --radius: {{ settings.radius }}px;
    --radius-lg: {{ settings.radius | times: 1.6 | round }}px;
    --logo-width: {{ settings.logo_width }}px;
  }
{% endstyle %}
