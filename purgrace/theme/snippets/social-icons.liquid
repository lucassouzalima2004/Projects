{%- doc -%}
  Links to the social profiles set in Theme settings → Social media.

  @param {string} [class] - Extra classes
{%- enddoc -%}
{%- liquid
  assign networks = 'instagram,tiktok,facebook,pinterest,youtube' | split: ','
  assign has_any = false
  for network in networks
    assign setting_key = 'social_' | append: network | append: '_link'
    if settings[setting_key] != blank
      assign has_any = true
    endif
  endfor
-%}
{%- if has_any -%}
  <ul class="social{% if class %} {{ class }}{% endif %}" role="list">
    {%- for network in networks -%}
      {%- assign setting_key = 'social_' | append: network | append: '_link' -%}
      {%- if settings[setting_key] != blank -%}
        <li>
          <a href="{{ settings[setting_key] }}" class="social__link" target="_blank" rel="noopener">
            {%- render 'icon', name: network -%}
            <span class="visually-hidden">{{ network | capitalize }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
