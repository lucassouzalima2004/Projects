[
  {
    "name": "theme_info",
    "theme_name": "Grace",
    "theme_version": "1.0.0",
    "theme_author": "PurGrace",
    "theme_documentation_url": "https://github.com/lucassouzalima2004/Projects",
    "theme_support_url": "https://github.com/lucassouzalima2004/Projects/issues"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Use a version without extra empty space around it. Leave empty to use the text logo below."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Logo width on desktop",
        "default": 132
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Text logo",
        "default": "PurGrace",
        "info": "Leave empty to use the store name."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 96 × 96 px. The butterfly works well."
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "Taken from the PurGrace logo: rose, ivory, cocoa and a touch of gold."
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FBF7F3"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Soft surface (behind product photos)",
        "default": "#F5ECE6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#2E211E"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#74625B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons and links)",
        "default": "#A65A4F"
      },
      {
        "type": "color",
        "id": "color_accent_deep",
        "label": "Accent hover",
        "default": "#8A4439"
      },
      {
        "type": "color",
        "id": "color_rose",
        "label": "Logo rose (butterflies and details)",
        "default": "#D08880"
      },
      {
        "type": "color",
        "id": "color_blush",
        "label": "Accent on dark bands",
        "default": "#EBC0B5"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold (stars and fine lines)",
        "default": "#B89155"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark bands",
        "default": "#2E211E"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Headings",
        "default": "cormorant_n5"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "jost_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1320
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "tidy_titles",
        "label": "Tidy product titles",
        "info": "Hides product codes at the end of titles (for example ' - 5428350000') and shows ALL CAPS titles in sentence case.",
        "default": true
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait (4:5)"
          },
          {
            "value": "adapt",
            "label": "Adapt to image"
          }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_blend_white",
        "label": "Blend white photo backgrounds into the page",
        "info": "Makes the white of studio photos take the soft surface colour. Turn off if your photos look darker.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show the on-model photo on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show colour swatches",
        "info": "For products with an option called Colour, Color or Cor that has swatches.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show product rating",
        "info": "Needs a reviews app that fills the standard rating metafields (for example Judge.me or Shopify Product Reviews).",
        "default": true
      },
      {
        "type": "text",
        "id": "badge_new_tag",
        "label": "Tag for the New badge",
        "default": "new"
      },
      {
        "type": "text",
        "id": "badge_bestseller_tag",
        "label": "Tag for the Bestseller badge",
        "default": "bestseller"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping from ($)",
        "info": "Shows a progress bar in the cart. Use 0 to hide it. Keep it the same as in Settings → Shipping and delivery.",
        "default": 149
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show gift message",
        "default": true
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Suggestions in the cart",
        "info": "Small, affordable pieces work best, such as earrings or pendants."
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "default": true
      }
    ]
  },
  {
    "name": "Size guide",
    "settings": [
      {
        "type": "paragraph",
        "content": "Ring sizes for the size guide pop-up on product pages and for the Size guide section. One size per line: Australian size, inside diameter (mm), circumference (mm) and the Brazilian size (aro)."
      },
      {
        "type": "textarea",
        "id": "ring_sizes",
        "label": "Ring sizes",
        "default": "N: 17.1, 53.8, 16\nP: 17.9, 56.3, 18\nR: 18.7, 58.8, 22\nT½: 19.7, 61.9, 24\nV½: 20.5, 64.4, 26\nY: 21.5, 67.5, 30\nZ+1: 22.3, 70.0, 32",
        "info": "Inside diameter and circumference follow the Australian standard sizes. The Brazilian size is the closest Rommanel aro."
      },
      {
        "type": "page",
        "id": "size_guide_page",
        "label": "Full size guide page",
        "info": "Linked from the pop-up. Create a page and choose the 'size-guide' template."
      }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shown in the footer and on the contact page."
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "Country code and number, digits only, for example 61412345678. Leave empty to hide WhatsApp."
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email"
      },
      {
        "type": "text",
        "id": "location_label",
        "label": "Where you are",
        "default": "Perth, Western Australia"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "default": "https://www.instagram.com/purgraceau"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Returns (Google)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Google can show return information next to your products. Keep it in line with your refund policy (Settings → Policies)."
      },
      {
        "type": "select",
        "id": "returns_policy",
        "label": "Change-of-mind returns",
        "options": [
          {
            "value": "finite",
            "label": "Accepted within a number of days"
          },
          {
            "value": "none",
            "label": "Not accepted"
          }
        ],
        "default": "finite"
      },
      {
        "type": "range",
        "id": "returns_days",
        "min": 7,
        "max": 90,
        "step": 1,
        "unit": "d",
        "label": "Return window",
        "default": 30
      },
      {
        "type": "select",
        "id": "returns_fees",
        "label": "Return shipping",
        "options": [
          {
            "value": "customer",
            "label": "Paid by the customer"
          },
          {
            "value": "free",
            "label": "Free"
          }
        ],
        "default": "customer"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search",
        "label": "Show results while typing",
        "default": true
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Reveal sections on scroll",
        "info": "Turned off automatically for visitors who ask their device to reduce motion.",
        "default": true
      }
    ]
  }
]
