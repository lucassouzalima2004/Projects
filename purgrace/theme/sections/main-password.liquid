{%- assign form_id = 'PasswordNewsletter-' | append: section.id -%}
<section class="password scheme-dark">
  <div class="password__inner container">
    {% render 'logo', class: 'logo--footer' %}
    <div class="password__art" aria-hidden="true">
      {% render 'jewel-art', kind: 'pendant' %}
    </div>
    <h1 class="password__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__text">{{ shop.password_message | escape }}</p>
    {%- endif -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
          <input type="email" id="PasswordEmail" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
          <button type="submit" class="btn btn--light">{{ 'templates.password.notify' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="newsletter__msg newsletter__msg--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-btn">{{ 'templates.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'templates.password.password' | t }}</label>
        <input type="password" id="StorePassword" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}" class="field__input">
        <button type="submit" class="btn btn--light btn--sm">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
    </details>
    <p class="password__powered">{{ powered_by_link }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Something <em>beautiful</em> is on its way."
    }
  ]
}
{% endschema %}
