{%- liquid
  assign menu = section.settings.menu
  assign cart_drawer = false
  if settings.cart_type == 'drawer' and request.page_type != 'cart'
    assign cart_drawer = true
  endif
-%}
<sticky-header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}">
  <div class="container header">
    <button
      type="button"
      class="header__icon header__menu"
      data-dialog-open="MenuDrawer"
      aria-controls="MenuDrawer"
      aria-expanded="false"
      aria-label="{{ 'general.menu' | t }}"
    >
      {%- render 'icon', name: 'menu' -%}
    </button>

    {% render 'logo', class: 'header__logo' %}

    {%- if menu.links.size > 0 -%}
      <nav class="header__nav" aria-label="{{ 'general.main_menu' | t }}">
        <ul class="nav" role="list">
          {%- for link in menu.links -%}
            <li class="nav__item">
              {%- if link.links != blank -%}
                <details class="nav__dropdown" data-dropdown>
                  <summary class="nav__link{% if link.child_active %} is-active{% endif %}">
                    {{- link.title | escape -}}
                    {% render 'icon', name: 'chevron-down', class: 'nav__chevron' %}
                  </summary>
                  <ul class="nav__submenu" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a href="{{ child.url }}" class="nav__sublink"{% if child.current %} aria-current="page"{% endif %}>
                          {{- child.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="nav__link{% if link.active %} is-active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header__icons">
      {%- if section.settings.show_localization -%}
        <div class="header__localization">
          {% render 'localization-form', id_prefix: 'header', show_country: false %}
        </div>
      {%- endif -%}
      <a href="{{ routes.search_url }}" class="header__icon" data-dialog-open="SearchModal" aria-label="{{ 'search.title' | t }}">
        {%- render 'icon', name: 'search' -%}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu | default: 'customer-account-main-menu' }}">
          <span slot="signed-out-avatar" class="header__icon">
            {%- render 'icon', name: 'account' -%}
            <span class="visually-hidden">{{ 'general.account' | t }}</span>
          </span>
        </shopify-account>
      {%- endif -%}
      <a
        href="{{ routes.cart_url }}"
        class="header__icon header__cart"
        id="CartLink"
        {% if cart_drawer %}
          data-dialog-open="CartDrawer"
          aria-haspopup="dialog"
        {% endif %}
      >
        {%- render 'icon', name: 'bag' -%}
        <span id="cart-icon-bubble">
          {%- render 'cart-count' -%}
        </span>
      </a>
    </div>
  </div>
</sticky-header>

<dialog id="MenuDrawer" class="drawer drawer--left menu-drawer" aria-label="{{ 'general.menu' | t }}">
  <div class="drawer__inner">
    <div class="drawer__head">
      {% render 'logo' %}
      <button type="button" class="icon-btn" data-dialog-close aria-label="{{ 'general.close' | t }}" autofocus>
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>
    <nav class="drawer__body menu-drawer__nav" aria-label="{{ 'general.main_menu' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          <li class="menu-drawer__item">
            {%- if link.links != blank -%}
              <details{% if link.child_active %} open{% endif %}>
                <summary class="menu-drawer__link">
                  {{- link.title | escape -}}
                  {% render 'icon', name: 'chevron-down' %}
                </summary>
                <ul role="list" class="menu-drawer__sub">
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="menu-drawer__link"{% if link.current %} aria-current="page"{% endif %}>
                {{- link.title | escape -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="drawer__foot menu-drawer__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="menu-drawer__account">
          {%- render 'icon', name: 'account' -%}
          {{- 'general.account' | t -}}
        </a>
      {%- endif -%}
      {% render 'localization-form', id_prefix: 'drawer' %}
      {% render 'social-icons' %}
    </div>
  </div>
</dialog>

<dialog id="SearchModal" class="search-modal" aria-label="{{ 'search.title' | t }}">
  <div class="search-modal__inner container">
    <predictive-search class="predictive" data-enabled="{{ settings.predictive_search }}">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-field">
        <label class="visually-hidden" for="SearchModalInput">{{ 'search.label' | t }}</label>
        {%- render 'icon', name: 'search', class: 'search-field__icon' -%}
        <input
          type="search"
          id="SearchModalInput"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          {% if settings.predictive_search %}
            role="combobox"
            aria-expanded="false"
            aria-controls="PredictiveResults"
            aria-autocomplete="list"
          {% endif %}
          autofocus
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="button" class="icon-btn" data-dialog-close aria-label="{{ 'general.close' | t }}">
          {%- render 'icon', name: 'close' -%}
        </button>
      </form>
      <div id="PredictiveResults" class="predictive__results" aria-live="polite"></div>
    </predictive-search>
  </div>
</dialog>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Keep header visible while scrolling",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show language switch",
      "info": "Appears when the store has more than one language (Settings → Languages).",
      "default": true
    }
  ]
}
{% endschema %}
