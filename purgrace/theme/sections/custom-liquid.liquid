<div class="section{% if section.settings.contained %} container{% endif %} custom-liquid">
  {{ section.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "Custom Liquid",
  "class": "section-custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "For app snippets, embeds and other code."
    },
    {
      "type": "checkbox",
      "id": "contained",
      "label": "Limit to page width",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
