{%- paginate blog.articles by 9 -%}
  <header class="collection-hero scheme-surface">
    <div class="container collection-hero__inner">
      <div class="collection-hero__copy">
        {% render 'breadcrumbs' %}
        <h1 class="collection-hero__title">{{ blog.title | escape }}</h1>
        {%- if section.settings.intro != blank -%}
          <div class="collection-hero__desc rte">{{ section.settings.intro }}</div>
        {%- endif -%}
        {%- if blog.all_tags.size > 0 -%}
          <ul class="tag-list" role="list">
            <li><a href="{{ blog.url }}" class="pill{% unless current_tags %} is-active{% endunless %}">{{ 'blogs.all_posts' | t }}</a></li>
            {%- for tag in blog.all_tags -%}
              <li>
                <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="pill{% if current_tags contains tag %} is-active{% endif %}">{{ tag | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </header>
  <section class="section section--tight">
    <div class="container">
      {%- if blog.articles.size > 0 -%}
        <ul class="article-grid article-grid--blog" role="list">
          {%- for post in blog.articles -%}
            {%- liquid
              assign featured = false
              if forloop.first and paginate.current_page == 1 and current_tags == blank
                assign featured = true
              endif
            -%}
            <li{% if featured %} class="article-grid__featured"{% endif %}>
              {% render 'article-card', card_article: post, featured: featured, heading_tag: 'h2' %}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'blogs.empty' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts list",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>How to care for your jewellery, the meaning behind each symbol and ideas for every occasion.</p>"
    }
  ]
}
{% endschema %}
