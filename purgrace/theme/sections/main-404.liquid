<section class="section not-found">
  <div class="container not-found__inner">
    <div class="not-found__art" aria-hidden="true">
      {% render 'butterfly', class: 'not-found__mark' %}
    </div>
    <p class="eyebrow">404</p>
    <h1 class="not-found__title">{{ 'templates.404.title_html' | t }}</h1>
    <p class="not-found__text">{{ 'templates.404.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-field search-field--page">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'search.label' | t }}</label>
      {%- render 'icon', name: 'search', class: 'search-field__icon' -%}
      <input type="search" id="NotFoundSearch" name="q" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="btn btn--primary btn--sm">{{ 'search.submit' | t }}</button>
    </form>
    <a href="{{ routes.all_products_collection_url }}" class="link-btn">{{ 'templates.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Page not found",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
